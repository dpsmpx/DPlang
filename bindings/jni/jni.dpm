// SPDX-License-Identifier: Apache-2.0
// Привязка JNI: функции JNIEnv и JavaVM — записи их таблиц (@slot, Р63).
// Сгенерировано bindings/gen/jni.py из jni.h (AOSP libnativehelper) — не править (Р58).
// jni.h: Copyright (C) 2006 The Android Open Source Project, Apache-2.0.
// Правила перевода типов C — docs/bindings/README.md.

// Ссылка Java: jobject и его имена в C (jclass, jstring, jthrowable, массивы).
pub extern type jobject
pub extern type jfieldID
pub extern type jmethodID
// JNIEnv* и JavaVM* в C: объект, первое слово которого — адрес таблицы функций.
pub extern type JNIEnv
pub extern type JavaVM
// void* без длины: указатель C без операций.
pub extern type JniVoid

// Константы
pub const JNI_FALSE: u8 = 0
pub const JNI_TRUE: u8 = 1
pub const JNI_VERSION_1_1: i32 = 65537
pub const JNI_VERSION_1_2: i32 = 65538
pub const JNI_VERSION_1_4: i32 = 65540
pub const JNI_VERSION_1_6: i32 = 65542
pub const JNI_OK: i32 = 0
pub const JNI_ERR: i32 = -1
pub const JNI_EDETACHED: i32 = -2
pub const JNI_EVERSION: i32 = -3
pub const JNI_ENOMEM: i32 = -4
pub const JNI_EEXIST: i32 = -5
pub const JNI_EINVAL: i32 = -6
pub const JNI_COMMIT: i32 = 1
pub const JNI_ABORT: i32 = 2
// jobjectRefType
pub const JNIInvalidRefType: i32 = 0
pub const JNILocalRefType: i32 = 1
pub const JNIGlobalRefType: i32 = 2
pub const JNIWeakGlobalRefType: i32 = 3

@union
pub struct jvalue {
    z: u8
    b: i8
    c: u16
    s: i16
    i: i32
    j: i64
    f: f32
    d: f64
    l: ?jobject
}

@c
pub struct JavaVMAttachArgs {
    version: i32
    name: str
    group: ?jobject
}

@c
pub struct JavaVMOption {
    option_string: str
    extra_info: ?JniVoid
}

@c
pub struct JavaVMInitArgs {
    version: i32
    n_options: i32
    @count(n_options) options: []JavaVMOption
    ignore_unrecognized: u8
}

