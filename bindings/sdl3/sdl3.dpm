// Пропущено — не выражается в dpl v0.2:
// - SDL_SetError: переменное число аргументов
// - SDL_SetErrorV: параметр ap: va_list
// - SDL_AddHintCallback: тип char* в указателе на функцию
// - SDL_RemoveHintCallback: тип char* в указателе на функцию
// - SDL_GetDisplays: результат SDL_DisplayID *: указатель на данные SDL
// - SDL_GetFullscreenDisplayModes: результат SDL_DisplayMode **: указатель на данные SDL
// - SDL_GetDesktopDisplayMode: результат const SDL_DisplayMode *: указатель на данные SDL
// - SDL_GetCurrentDisplayMode: результат const SDL_DisplayMode *: указатель на данные SDL
// - SDL_GetWindowFullscreenMode: результат const SDL_DisplayMode *: указатель на данные SDL
// - SDL_GetWindows: результат SDL_Window **: указатель на данные SDL
// - SDL_SetWindowIcon: параметр icon: объект SDL_Surface
// - SDL_GetWindowSurface: результат SDL_Surface *: указатель на данные SDL
// - SDL_GetWindowMouseRect: результат const SDL_Rect *: указатель на данные SDL
// - SDL_SetWindowShape: параметр shape: объект SDL_Surface
// - SDL_GL_GetProcAddress: результат SDL_FunctionPointer
// - SDL_EGL_GetProcAddress: результат SDL_FunctionPointer
// - SDL_EGL_SetAttributeCallbacks: тип SDL_EGLAttrib* в указателе на функцию
// - SDL_Vulkan_GetVkGetInstanceProcAddr: результат SDL_FunctionPointer
// - SDL_Vulkan_GetInstanceExtensions: результат char const * const *: указатель на данные SDL
// - SDL_GetEventFilter: параметр filter: SDL_EventFilter *
// - SDL_GetEventDescription: параметр buf: буфер строки
// - SDL_GetKeyboards: результат SDL_KeyboardID *: указатель на данные SDL
// - SDL_GetKeyboardState: результат const bool *: указатель на данные SDL
// - SDL_GetMice: результат SDL_MouseID *: указатель на данные SDL
// - SDL_SetRelativeMouseTransform: тип float* в указателе на функцию
// - SDL_CreateColorCursor: параметр surface: объект SDL_Surface
// - SDL_CreateAnimatedCursor: параметр frames: массив вывода
