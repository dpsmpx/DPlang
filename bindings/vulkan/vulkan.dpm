// void* без длины: указатель C без операций (pUserData, отображённая память).
pub extern type VkVoid

// Версии API: VK_MAKE_API_VERSION(variant, major, minor, patch).
pub fn VK_MAKE_API_VERSION(variant: u32, major: u32, minor: u32, patch: u32) u32 {
    return (variant << 29) | (major << 22) | (minor << 12) | patch
}

