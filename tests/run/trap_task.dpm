// spec: О13, прототип (docs/research/notes/10_concurrency.md, раздел 6)
// Ловушка в задаче: сначала её вывод, затем ловушка; программа кончается.
fn boom(xs: &List[int]) {
    println("before")
    println(str(xs[5]))
}

fn main() {
    let xs = [1, 2]
    tasks {
        spawn boom(&xs)
    }
    println("after")
}
