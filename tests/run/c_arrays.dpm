// spec: ffi.struct
// Массив [N]T в полях @c (Р62): индекс, len, срез, литерал из N элементов,
// вложенные массивы; ноль пропущенного поля @c.
@c
struct Props {
    id: u32
    name: [8]u8
    m: [2][3]f32
}

fn total(xs: []u8) i64 {
    var s: i64 = 0
    for x in &xs {
        s = s + i64(x)
    }
    return s
}

fn main() {
    var p = Props { id: 7, name: [65, 66, 67, 0, 0, 0, 0, 0], m: [[1, 2, 3], [4, 5, 6]] }
    p.name[3] = 68
    println(str(p.id) + " " + str(len(p.name)) + " " + str(p.name[3]) + " " + str(total(p.name)))
    p.m[1][2] = 9.5
    println(str(p.m[1][2]) + " " + str(len(p.m[0])))
    println(str(total(p.name[1..3])))
}
