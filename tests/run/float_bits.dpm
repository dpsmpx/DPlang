// spec: expr.convert module.det (Р56, Р71)
// Биты IEEE 754: f64.bits, f64.from_bits, у f32 — то же; в классе D NaN
// канонический — одни биты на всех целях.
fn hex(h: u64) str {
    let digits = "0123456789abcdef"
    var s = ""
    for i in 0..16 {
        let d = i64((h >> u64(60 - 4 * i)) & 15)
        s += digits[d..d + 1]
    }
    return s
}

@det
fn nan_bits(z: f64) u64 {
    return f64.bits(z / z)
}

fn main() {
    println(hex(f64.bits(1.0)))
    println(hex(f64.bits(-0.0)))
    println(hex(f64.bits(0.1)))
    println(hex(u64(f32.bits(1.0))))
    println(hex(u64(f32.bits(-2.5))))
    let x: f64 = 3.141592653589793
    println(str(f64.from_bits(f64.bits(x)) == x))
    println(str(f64.from_bits(0x7FF0000000000000)))
    println(str(f32.from_bits(0x3F800000)))
    let small: f32 = 0.5
    println(hex(f64.bits(small)))
    println(hex(nan_bits(0.0)))
}
