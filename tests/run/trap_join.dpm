// spec: О13, прототип (docs/research/notes/10_concurrency.md, раздел 6)
// Вариант В: повторный join — ловушка; вывод задачи выходит при join.
fn work(n: int) int {
    println("work " + str(n))
    return n * 2
}

fn main() {
    let t = spawn work(21)
    let copy = t
    println(str(t.join()))
    println(str(copy.join()))
}
