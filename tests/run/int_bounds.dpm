// spec: trap.int builtin.functions
// Края целых типов: сложение, вычитание и умножение каждой пары. Если
// checked_* даёт значение, печатается обычная операция (путь без
// ловушки), иначе «-». Сборки на всех целях сверяются с интерпретатором.

fn grid_i8() {
    let vs: List[i8] = [-128, -127, -1, 0, 1, 126, 127]
    for i in 0..len(vs) {
        let a = vs[i]
        var add = "i8 " + str(a) + " +"
        var sub = "  -"
        var mul = "  *"
        for j in 0..len(vs) {
            let b = vs[j]
            if let _ = checked_add(a, b) {
                add += " " + str(a + b)
            } else {
                add += " -"
            }
            if let _ = checked_sub(a, b) {
                sub += " " + str(a - b)
            } else {
                sub += " -"
            }
            if let _ = checked_mul(a, b) {
                mul += " " + str(a * b)
            } else {
                mul += " -"
            }
        }
        println(add)
        println(sub)
        println(mul)
    }
}

