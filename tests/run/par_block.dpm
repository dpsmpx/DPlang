// spec: О13, прототип (docs/research/notes/10_concurrency.md, раздел 6)
// Вариант Б: parallel { … } — каждый оператор задача, первый в текущем
// потоке; вывод — в порядке операторов.
fn sum(xs: &List[int]) int {
    var s = 0
    for x in &xs {
        s += x
    }
    return s
}

fn fill(out: &mut List[int], n: int) {
    for i in 0..n {
        out.push(i)
    }
    println("filled " + str(n))
}

fn main() {
    let xs = [1, 2, 3, 4]
    var a = 0
    var b = 0
    var ys: List[int] = []
    var pair = [0, 0]
    let c = atomic(0)
    parallel {
        a = sum(&xs)
        b = sum(&xs) * 2
        fill(&mut ys, 3)
        {
            println("block task")
            pair[1] = 7
            _ = c.add(5)
        }
        _ = c.add(1)
    }
    println(str(a) + " " + str(b) + " " + str(len(ys)) + " " + str(pair[1]) + " " + str(c.load()))
}
