// spec: syntax syntax.block
struct Point {
    x: i32
    y: i32 = 7
}

fn area(p: &Point) i64 {
    let a = i64(p.x) * i64(p.y)
    if a > 0 {
        return a
    } else {
        return -a
    }
}

fn main() {
    let p = Point { x: 3 }
    match p.y {
        0 => println("zero")
        _ => {}
    }

    println(str(area(&p)))
}
