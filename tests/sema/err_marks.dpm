// spec: ref.marks expr.call
// Пометка `&` у аргумента вызова, который не разрешился или не сошёлся по
// числу аргументов, — без второго сообщения E0501.
fn one(x: &i32) {
}

fn f() {
    var b = 1
    var xs: List[i32] = []
    nope(&b, 1)
    one(&b, &mut b)
    xs.nothing(&b)
    len(&xs, 2)
}
