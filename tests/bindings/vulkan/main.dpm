// spec: module.import ffi.types ffi.struct
// Привязка Vulkan (Р58, Р62) на программном драйвере lavapipe: экземпляр,
// физическое устройство и его свойства, логическое устройство с цепочкой
// pNext, буфер в памяти хоста, команда заливки, отправка в очередь и
// чтение результата через отображённую память.
import vulkan

extern fn memmove(dst: &mut List[u8], src: vulkan.VkVoid, n: u64) ?vulkan.VkVoid

fn llvmpipe(name: []u8) bool {
    let want: List[u8] = [108, 108, 118, 109, 112, 105, 112, 101]
    var i = 0
    while i < len(want) {
        if name[i] != want[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() {
    var version: u32 = 0
    _ = vulkan.vkEnumerateInstanceVersion(&mut version)
    println("loader 1.3+: " + str(version >= vulkan.VK_API_VERSION_1_3))
    var n: u32 = 0
    var exts: List[vulkan.VkExtensionProperties] = []
    _ = vulkan.vkEnumerateInstanceExtensionProperties(none, &mut n, &mut exts)
    exts = repeat(vulkan.VkExtensionProperties {}, int(n))
    _ = vulkan.vkEnumerateInstanceExtensionProperties(none, &mut n, &mut exts)
    println("instance extensions: " + str(n > 0 && exts[0].extension_name[0] != 0))
    var inst: ?vulkan.VkInstance = none
    let rc = vulkan.vkCreateInstance(&vulkan.VkInstanceCreateInfo {
        p_application_info: &vulkan.VkApplicationInfo {
            p_application_name: "dpl-test",
            application_version: vulkan.VK_MAKE_API_VERSION(0, 0, 1, 0),
            p_engine_name: "dpl",
            api_version: vulkan.VK_API_VERSION_1_3,
        },
        pp_enabled_layer_names: [],
        pp_enabled_extension_names: [],
    }, none, &mut inst)
    println("vkCreateInstance: " + str(rc))
    if let i = inst {
        physical(i)
        vulkan.vkDestroyInstance(i, none)
        println("instance destroyed")
    }
}

fn physical(inst: vulkan.VkInstance) {
    var count: u32 = 0
    var devs: List[?vulkan.VkPhysicalDevice] = []
    _ = vulkan.vkEnumeratePhysicalDevices(inst, &mut count, &mut devs)
    devs = repeat(none, int(count))
    _ = vulkan.vkEnumeratePhysicalDevices(inst, &mut count, &mut devs)
    println("physical devices: " + str(count >= 1))
    if let pd = devs[0] {
        var props = vulkan.VkPhysicalDeviceProperties {}
        vulkan.vkGetPhysicalDeviceProperties(pd, &mut props)
        println("llvmpipe: " + str(llvmpipe(props.device_name)) + ", cpu: " +
                str(props.device_type == vulkan.VK_PHYSICAL_DEVICE_TYPE_CPU) + ", 1.3: " +
                str(props.api_version >= vulkan.VK_API_VERSION_1_3) + ", 2D images to 4096: " +
                str(props.limits.max_image_dimension2d >= 4096))
        var qn: u32 = 0
        var families: List[vulkan.VkQueueFamilyProperties] = []
        vulkan.vkGetPhysicalDeviceQueueFamilyProperties(pd, &mut qn, &mut families)
        families = repeat(vulkan.VkQueueFamilyProperties {}, int(qn))
        vulkan.vkGetPhysicalDeviceQueueFamilyProperties(pd, &mut qn, &mut families)
        var family: u32 = 0
        var found = false
        var i: u32 = 0
        while i < qn {
            if !found && (families[int(i)].queue_flags & vulkan.VK_QUEUE_GRAPHICS_BIT) != 0 {
                family = i
                found = true
            }
            i = i + 1
        }
        println("graphics queue family: " + str(found))
        var mem = vulkan.VkPhysicalDeviceMemoryProperties {}
        vulkan.vkGetPhysicalDeviceMemoryProperties(pd, &mut mem)
        let want = vulkan.VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | vulkan.VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
        var kind: u32 = 0
        var host = false
        var k: u32 = 0
        while k < mem.memory_type_count {
            if !host && (mem.memory_types[int(k)].property_flags & want) == want {
                kind = k
                host = true
            }
            k = k + 1
        }
        println("host-visible memory: " + str(host))
        if found && host {
            device(pd, family, kind)
        }
    }
}

fn device(pd: vulkan.VkPhysicalDevice, family: u32, kind: u32) {
    var dev: ?vulkan.VkDevice = none
    // Цепочка pNext: &VkPhysicalDeviceVulkan13Features → &VkBaseInStructure (Р62).
    let rc = vulkan.vkCreateDevice(pd, &vulkan.VkDeviceCreateInfo {
        p_next: &vulkan.VkPhysicalDeviceVulkan13Features { synchronization2: vulkan.VK_TRUE },
        p_queue_create_infos: [vulkan.VkDeviceQueueCreateInfo { queue_family_index: family, p_queue_priorities: [1.0] }],
        pp_enabled_layer_names: [],
        pp_enabled_extension_names: [],
    }, none, &mut dev)
    println("vkCreateDevice: " + str(rc))
    if let d = dev {
        var queue: ?vulkan.VkQueue = none
        vulkan.vkGetDeviceQueue(d, family, 0, &mut queue)
        if let q = queue {
            fill(d, q, family, kind)
        }
        vulkan.vkDestroyDevice(d, none)
        println("device destroyed")
    }
}

fn fill(d: vulkan.VkDevice, q: vulkan.VkQueue, family: u32, kind: u32) {
    var buf: ?vulkan.VkBuffer = none
    _ = vulkan.vkCreateBuffer(d, &vulkan.VkBufferCreateInfo {
        size: 64,
        usage: vulkan.VK_BUFFER_USAGE_TRANSFER_DST_BIT,
        sharing_mode: vulkan.VK_SHARING_MODE_EXCLUSIVE,
        p_queue_family_indices: [],
    }, none, &mut buf)
    var pool: ?vulkan.VkCommandPool = none
    _ = vulkan.vkCreateCommandPool(d, &vulkan.VkCommandPoolCreateInfo { queue_family_index: family }, none, &mut pool)
    if let b = buf {
        if let p = pool {
            var req = vulkan.VkMemoryRequirements {}
            vulkan.vkGetBufferMemoryRequirements(d, b, &mut req)
            var memory: ?vulkan.VkDeviceMemory = none
            _ = vulkan.vkAllocateMemory(d, &vulkan.VkMemoryAllocateInfo { allocation_size: req.size, memory_type_index: kind },
                                        none, &mut memory)
            if let m = memory {
                println("vkBindBufferMemory: " + str(vulkan.vkBindBufferMemory(d, b, m, 0)))
                record(d, q, p, b)
                var ptr: ?vulkan.VkVoid = none
                println("vkMapMemory: " + str(vulkan.vkMapMemory(d, m, 0, vulkan.VK_WHOLE_SIZE, 0, &mut ptr)))
                if let at = ptr {
                    var out: List[u8] = repeat(u8(0), 8)
                    _ = memmove(&mut out, at, 8)
                    println("filled: " + str(out[0]) + " " + str(out[1]) + " " + str(out[2]) + " " + str(out[3]) + " " +
                            str(out[4]))
                    vulkan.vkUnmapMemory(d, m)
                }
                vulkan.vkFreeMemory(d, m, none)
            }
            vulkan.vkDestroyCommandPool(d, p, none)
        }
        vulkan.vkDestroyBuffer(d, b, none)
    }
}

fn record(d: vulkan.VkDevice, q: vulkan.VkQueue, pool: vulkan.VkCommandPool, b: vulkan.VkBuffer) {
    var cbs: List[?vulkan.VkCommandBuffer] = [none]
    _ = vulkan.vkAllocateCommandBuffers(d, &vulkan.VkCommandBufferAllocateInfo {
        command_pool: pool,
        level: vulkan.VK_COMMAND_BUFFER_LEVEL_PRIMARY,
        command_buffer_count: 1,
    }, &mut cbs)
    if let cb = cbs[0] {
        _ = vulkan.vkBeginCommandBuffer(cb, &vulkan.VkCommandBufferBeginInfo {
            flags: vulkan.VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
        })
        vulkan.vkCmdFillBuffer(cb, b, 0, vulkan.VK_WHOLE_SIZE, 67305985)  // 0x04030201
        _ = vulkan.vkEndCommandBuffer(cb)
        let rc = vulkan.vkQueueSubmit(q, 1, [vulkan.VkSubmitInfo {
            p_wait_semaphores: [],
            p_wait_dst_stage_mask: [],
            p_command_buffers: [cb],
            p_signal_semaphores: [],
        }], none)
        println("vkQueueSubmit: " + str(rc) + ", vkQueueWaitIdle: " + str(vulkan.vkQueueWaitIdle(q)))
        vulkan.vkFreeCommandBuffers(d, pool, 1, [cb])
    }
}
