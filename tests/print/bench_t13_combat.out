import world

pub enum CombatError {
    NotFound
    Dead
}

fn after_armor(dmg: i32, armor: i32) i32 {
    return max(1, dmg - armor)
}

pub fn apply_damage(w: &mut world.World, id: world.UnitId, dmg: i32) !i32 {
    if id.index < 0 || id.index >= len(w.units) {
        fail .NotFound
    }
    if w.units[id.index].hp == 0 {
        fail .Dead
    }
    let hp = max(0, w.units[id.index].hp - after_armor(dmg, w.units[id.index].armor))
    w.units[id.index].hp = hp
    return hp
}

pub fn blast(w: &mut world.World, cx: i32, cy: i32, r: i32, dmg: i32) List[world.UnitId] {
    var hits: List[world.UnitId] = []
    for i in 0..len(w.units) {
        let u = w.units[i]
        if u.hp > 0 && abs(u.x - cx) <= r && abs(u.y - cy) <= r {
            let id = world.UnitId { index: i32(i) }
            _ = apply_damage(&mut w, id, dmg)
            hits.push(id)
        }
    }
    return hits
}
