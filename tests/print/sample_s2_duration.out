pub enum DurationError {
    Empty
    BadNumber
    BadUnit
}

fn unit_seconds(c: u8) ?i64 {
    match c {
        'h' => return 3600
        'm' => return 60
        's' => return 1
        _ => return none
    }
}

pub fn parse_duration(text: str) !i64 {
    let s = text.trim()
    if len(s) == 0 {
        fail .Empty
    }
    var total: i64 = 0
    var i = 0
    while i < len(s) {
        let start = i
        while i < len(s) && is_digit(s[i]) {
            i += 1
        }
        if i == start || i == len(s) {
            fail .BadNumber
        }
        let n = parse_int(s[start..i]) ?? -1
        if n < 0 {
            fail .BadNumber
        }
        if let k = unit_seconds(s[i]) {
            total += n * k
        } else {
            fail .BadUnit
        }
        i += 1
    }
    return total
}

pub fn total_seconds(items: []str) !i64 {
    var sum: i64 = 0
    for item in &items {
        sum += try parse_duration(item)
    }
    return sum
}

pub fn format_duration(seconds: i64) str {
    let h = seconds / 3600
    let m = seconds % 3600 / 60
    let s = seconds % 60
    var out = ""
    if h > 0 {
        out += str(h) + "h"
    }
    if m > 0 {
        out += str(m) + "m"
    }
    if s > 0 || out == "" {
        out += str(s) + "s"
    }
    return out
}
