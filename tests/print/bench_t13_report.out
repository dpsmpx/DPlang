import world

pub fn describe(w: &world.World) str {
    var out = ""
    for i in 0..len(w.units) {
        if i > 0 {
            out += " "
        }
        let u = w.units[i]
        if u.hp > 0 {
            out += str(i) + ":" + str(u.hp)
        } else {
            out += str(i) + ":dead"
        }
    }
    return out
}

pub fn alive_count(w: &world.World) i32 {
    var n: i32 = 0
    for u in &w.units {
        if u.hp > 0 {
            n += 1
        }
    }
    return n
}
