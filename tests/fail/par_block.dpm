// spec: О13, прототип (docs/research/notes/10_concurrency.md, раздел 6)
// Вариант Б: операторы не делят место, которое один из них меняет (E0521);
// без let и defer в блоке (E0520); из блока не выходят (E0516).
fn main() {
    var a = 0
    var xs = [0, 0]
    parallel {
        a = 1
        a = 2
    }
    parallel {
        xs[0] = a
        a = 3
    }
    parallel {
        xs[0] = 1
        xs[1] = 2
        let k = 1
        return
    }
    parallel {
        xs.push(1)
        println(str(len(xs)))
    }
}
