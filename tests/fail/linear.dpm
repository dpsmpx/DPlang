// spec: ffi.linear stmt.destructure stmt.errdefer
// Поток линейных значений (Р60): не закрыт, закрыт дважды, нельзя здесь.
enum E {
    Bad
}

@linear
struct Res {
    id: int
}

@linear
struct Pair {
    a: Res
    b: Res
}

fn open(id: int) Res {
    return Res { id: id }
}

fn close(r: Res) {
    let Res { id: _ } = r
}

fn may(id: int) E!Res {
    if id < 0 {
        fail .Bad
    }
    return open(id)
}

fn wrap(r: Res) E!Res {
    return r
}

fn leak() {
    let r = open(1)
}

fn leak_call() {
    open(2)
}

fn leak_discard() {
    _ = open(3)
}

fn twice() {
    let r = open(4)
    close(r)
    close(r)
}

fn moved() {
    let r = open(5)
    let s = r
    close(s)
    println(str(r.id))
}

fn maybe(flag: bool) {
    let r = open(6)
    if flag {
        close(r)
    }
}

fn in_loop() {
    let r = open(7)
    for i in 0..2 {
        close(r)
    }
}

fn after_defer() {
    let r = open(8)
    defer close(r)
    close(r)
}

fn field_move(p: Pair) {
    close(p.a)
    let Pair { a, b } = p
    close(a)
    close(b)
}

fn field_assign(p: Pair) {
    var q = p
    q.a = open(9)
    let Pair { a, b } = q
    close(a)
    close(b)
}

fn drop_field(p: Pair) {
    let Pair { a, b: _ } = p
    close(a)
}

fn overwrite() {
    var r = open(10)
    r = open(11)
    close(r)
}

fn wild() {
    match may(12) {
        ok(_) => println("ok")
        err(_) => println("err")
    }
}

fn no_errdefer() E!void {
    let r = open(13)
    let s = try may(14)
    close(s)
    close(r)
}

fn errdefer_only() E!void {
    let r = open(15)
    errdefer close(r)
    return
}

fn closed_then_fail(flag: bool) E!void {
    let r = open(16)
    errdefer close(r)
    close(r)
    if flag {
        fail .Bad
    }
}

fn moved_into_result() E!Res {
    let r = open(17)
    errdefer close(r)
    return wrap(r)
}

fn through_ref(r: &Res) {
    close(r)
}

fn replace_ref(r: &mut Res) {
    r = open(18)
}

fn main() {
}

fn peek(r: &Res, n: int) int {
    return n
}

fn give(r: Res) int {
    close(r)
    return 0
}

// Ссылка аргументом левее живёт до конца вызова: закрыть ресурс правее
// нельзя; ссылка во вложенном вызове кончается с ним.
fn borrow_then_close() {
    let r = open(19)
    _ = peek(&r, give(r))
    let q = open(20)
    _ = peek(&q, peek(&q, 1)) + give(q)
    let xs = [1, 2]
    let h = open(0)
    _ = at(&xs[h.id], give(h))
}

// Получатель метода и место присваивания вычислены до аргумента и
// значения: поглотить их корень там нельзя.
@linear
struct Bag {
    items: List[int]
}

fn drop_bag(b: Bag) int {
    let Bag { items } = b
    return len(items)
}

fn write_after_close() {
    var b = Bag { items: [1] }
    b.items.push(drop_bag(b))
    var c = Bag { items: [1] }
    c.items[0] = drop_bag(c)
}

fn at(x: &int, n: int) int {
    return x + n
}

// Ссылка в литерале для C: в списке заимствующих структур и в том же
// аргументе, что и закрытие.
@c
@linear
struct CRes {
    id: u32
}

@c
struct View {
    p: &CRes
    n: u32
}

@c
struct OptView {
    p: ?&CRes
}

extern fn see(v: &View) u32
extern fn see_one(v: View, n: u32) u32
extern fn see_all(vs: []View, n: u32) u32
extern fn see_opts(vs: []OptView, n: u32) u32

fn c_give(r: CRes) u32 {
    let CRes { id } = r
    return id
}

fn borrow_in_literal(a: CRes, b: CRes, c: CRes) {
    _ = see_all([View { p: &a, n: 1 }], c_give(a))
    _ = see_opts([OptView { p: &b }], c_give(b))
    _ = see(&View { p: &c, n: c_give(c) })
}

fn borrow_in_part(a: CRes, b: CRes) {
    _ = see_all([View { p: &a, n: 1 }, View { p: &a, n: 2 }][0..1], c_give(a))
    _ = see_one([View { p: &b, n: 1 }][0], c_give(b))
}
