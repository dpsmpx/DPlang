enum Wrap {
    One([]i32)
}

const C: []i32 = [1]

fn ret(xs: []i32) []i32 {
    return xs
}

fn by_ref(xs: &[]i32) {
}

fn nested(xs: List[[]i32]) {
}

fn grow(a: &mut List[i32], view: []i32) {
}

fn uses(xs: List[i32]) {
    let part = xs[1..]
    let typed: []i32 = xs
    var list: List[i32] = [1, 2]
    grow(&mut list, list)
    grow(&mut list, list[1..])
}

fn read(a: &i32, b: &mut List[i32]) {
}

// Обходы: срез в скобках, псевдоним цикла по срезу, имя образца со срезом.
fn bypass(xs: List[i32]) {
    var list: List[i32] = [1, 2, 3]
    grow(&mut list, (list[1..]))
    grow(&mut list, ((list)))
    for x in &list[0..2] {
        read(&x, &mut list)
    }
    match list[0..2] {
        part => grow(&mut list, part)
    }
}
