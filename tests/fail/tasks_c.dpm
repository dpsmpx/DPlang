// spec: О13, прототип (docs/research/notes/10_concurrency.md, раздел 6)
// DPL_TASKS=c (tasks_c.env): блоки вариантов А и Б — E0519; ручки
// конкурентных значений копируются.
fn work(c: Atomic[int]) {
    _ = c.add(1)
}

fn main() {
    let c = atomic(0)
    let copy = c
    let t = spawn work(copy)
    t.join()
    var a = 0
    tasks {
        spawn work(c)
    }
    parallel {
        a = 1
    }
}
