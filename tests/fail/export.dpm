fn plain(a: i32) i32 {
    return a
}

@det
fn det_call(f: extern fn(i32) i32) i32 {
    return f(1)
}

fn main() {
    let f = plain
    let g: extern fn(i32) i32 = twice
    let h: extern fn(i64) i32 = twice
    println(str(g(1, 2)))
    let same = g == g
}
