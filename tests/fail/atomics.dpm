struct Stats {
    hits: Atomic[i64]
}

fn take(a: Atomic[i64]) {
}

fn give() Atomic[i64] {
    return atomic(1)
}

fn lists(xs: &List[Atomic[i32]]) {
}

@det
fn pure(a: &Atomic[i64]) i64 {
    return a.load()
}

fn main() {
    let a: Atomic[i64] = atomic(0)
    let b = a
    var c = atomic(5)
    c = atomic(6)
    let d: Atomic[str] = atomic("x")
    let f = atomic(1.5)
    let g = atomic(true)
    _ = g.add(1)
    println(str(a == a))
    let h: Atomic[f64] = atomic(1.0)
}
