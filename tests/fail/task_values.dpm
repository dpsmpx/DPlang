// spec: О13, прототип (docs/research/notes/10_concurrency.md, раздел 6)
// Вариант В: задача берёт аргументы значениями (E0520), это вызов функции
// dpl; у Task только join; класс D задач не ставит (E0425).
extern type Win

fn work(n: &int) int {
    return n
}

fn view(xs: []int) int {
    return 0
}

fn take(w: ?Win) {
}

@det
fn pure() {
    let t = spawn take(none)
}

fn main() {
    var a = 1
    let xs = [1, 2]
    let t1 = spawn work(&a)
    let t2 = spawn view(xs[0..1])
    let t3 = spawn take(none)
    let t4 = spawn print("x")
    let t5 = spawn (a + 1)
    let t6: Task[int] = spawn view(xs)
    t6.wait()
    let n: int = t6.join(1)
}
