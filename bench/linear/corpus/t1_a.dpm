// t1 — запись частями; А: файл закрывается в цикле на пути, который из него выходит.
import os

fn save(path: str, parts: &List[List[u8]]) os.IoError!void {
    var f = try os.create(path)
    for p in &parts {
        match os.write(&mut f, p) {
            ok(_) => {}
            err(e) => {
                _ = os.close(f)
                fail e
            }
        }
    }
    try os.close(f)
}

fn main() {}
