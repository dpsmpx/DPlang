// t1 — запись частями; как сейчас: ошибка запоминается, файл — после цикла.
import os

fn save(path: str, parts: &List[List[u8]]) os.IoError!void {
    var f = try os.create(path)
    var failed: ?os.IoError = none
    for p in &parts {
        match os.write(&mut f, p) {
            ok(_) => {}
            err(e) => {
                failed = e
                break
            }
        }
    }
    if let e = failed {
        _ = os.close(f)
        fail e
    }
    try os.close(f)
}

fn main() {}
