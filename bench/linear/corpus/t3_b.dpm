// t3 — заголовок, части, итог в одном файле; Б.
import os

fn header(n: int) List[u8] {
    return [u8(n & 255), 0, 0, 0]
}

fn save(path: str, parts: &List[List[u8]]) os.IoError!void {
    var f = try os.create(path)
    errdefer _ = os.close(f)
    try os.write(&mut f, header(len(parts)))
    for p in &parts {
        try os.write(&mut f, p)
    }
    try os.write(&mut f, [255])
    try os.close(f)
}

fn main() {}
