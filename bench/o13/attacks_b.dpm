// Атаки на модель задач Б (DPL_TASKS=b): каждая — отдельная программа
// между строками «// === имя: что пробует | ожидание» (race — гонка данных,
// safe — без гонки, logic — логическая гонка). Разбор — bench/o13/attacks.py.

// === b01: два оператора пишут одну переменную | race
fn add(x: &mut i64, v: i64) {
    for i in 0..1000 {
        x += v
    }
}

fn main() {
    var x: i64 = 0
    parallel {
        add(&mut x, 1)
        add(&mut x, 2)
    }
    println(str(x))
}

// === b02: один оператор пишет, другой читает | race
fn add(x: &mut i64) {
    for i in 0..1000 {
        x += 1
    }
}

fn main() {
    var x: i64 = 0
    var y: i64 = 0
    parallel {
        add(&mut x)
        y = x
    }
    println(str(y))
}

// === b03: оператор растит список, другой читает длину | race
fn main() {
    var xs: List[i64] = [1]
    var n: i64 = 0
    parallel {
        xs.push(2)
        n = len(xs)
    }
    println(str(n))
}

// === b04: разные поля структуры | safe
struct Pair {
    a: i64,
    b: i64,
}

fn main() {
    var p = Pair { a: 0, b: 0 }
    parallel {
        p.a = 1
        p.b = 2
    }
    println(str(p.a + p.b))
}

// === b05: постоянные индексы 0 и 1 | safe
fn main() {
    var out: List[i64] = [0, 0]
    parallel {
        out[0] = 1
        out[1] = 2
    }
    println(str(out[0] + out[1]))
}

// === b06: вычисленные индексы i и j | race
fn main() {
    var out: List[i64] = [0, 0]
    let i = 1
    let j = 1
    parallel {
        out[i] = 1
        out[j] = 2
    }
    println(str(out[1]))
}

// === b07: &mut и & одного места в вызовах | race
fn add(x: &mut i64) {
    x += 1
}

fn show(x: &i64) {
    println(str(x))
}

fn main() {
    var x: i64 = 0
    parallel {
        add(&mut x)
        show(&x)
    }
}

// === b08: два блока-оператора меняют одно | race
fn main() {
    var x: i64 = 0
    parallel {
        {
            x += 1
        }
        {
            x += 2
        }
    }
    println(str(x))
}

// === b09: цикл в операторе пишет, другой читает | race
fn main() {
    var acc: i64 = 0
    var seen: i64 = 0
    parallel {
        for i in 0..1000 {
            acc += 1
        }
        seen = acc
    }
    println(str(seen))
}

// === b10: parallel for в операторе пишет out, другой читает out | race
fn fill(out: &mut List[i64]) {
    parallel for i in 0..len(out) {
        out[i] = i64(i)
    }
}

fn main() {
    var out: List[i64] = repeat(i64(0), 100)
    var s: i64 = 0
    parallel {
        fill(&mut out)
        s = out[5]
    }
    println(str(s))
}

// === b11: вложенный блок пишет то же, что внешний оператор | race
fn main() {
    var x: i64 = 0
    var y: i64 = 0
    parallel {
        x = 1
        parallel {
            y = 2
            x = 3
        }
    }
    println(str(x + y))
}

// === b12: Map — вставка и чтение | race
fn main() {
    var m: Map[i64, i64] = []
    var n: i64 = 0
    parallel {
        m[1] = 1
        n = len(m)
    }
    println(str(n))
}

// === b13: атомик add в двух операторах | safe
fn bump(c: &Atomic[i64]) {
    for i in 0..10000 {
        _ = c.add(1)
    }
}

fn main() {
    let c = atomic(i64(0))
    parallel {
        bump(&c)
        bump(&c)
    }
    println(str(c.load()))
}

// === b14: атомик load/store по отдельности | logic
fn bump(c: &Atomic[i64]) {
    for i in 0..10000 {
        c.store(c.load() + 1)
    }
}

fn main() {
    let c = atomic(i64(0))
    parallel {
        bump(&c)
        bump(&c)
    }
    println(str(c.load() <= 20000))
}

// === b15: мьютекс в двух операторах | safe
fn bump(m: &Mutex[i64]) {
    for i in 0..10000 {
        lock m as v {
            v += 1
        }
    }
}

fn main() {
    let m = mutex(i64(0))
    parallel {
        bump(&m)
        bump(&m)
    }
    lock m as v {
        println(str(v))
    }
}

// === b16: канал — производитель и потребитель | safe
fn produce(ch: &Channel[i64]) {
    for i in 0..100 {
        ch.send(i64(i))
    }
    ch.close()
}

fn consume(ch: &Channel[i64], out: &mut i64) {
    while true {
        if let v = ch.recv() {
            out += v
        } else {
            break
        }
    }
}

fn main() {
    let ch: Channel[i64] = channel(4)
    var s: i64 = 0
    parallel {
        produce(&ch)
        consume(&ch, &mut s)
    }
    println(str(s))
}

// === b17: обход &mut в одном операторе, чтение в другом | race
fn main() {
    var xs: List[i64] = [1, 2, 3]
    var s: i64 = 0
    parallel {
        for x in &mut xs {
            x += 1
        }
        s = xs[0]
    }
    println(str(s))
}

// === b18: два оператора читают одно | safe
fn main() {
    let xs = [1, 2, 3]
    var a: i64 = 0
    var b: i64 = 0
    parallel {
        a = xs[0]
        b = xs[2]
    }
    println(str(a + b))
}

// === b19: структура целиком и её поле | race
struct Pair {
    a: i64,
    b: i64,
}

fn main() {
    var p = Pair { a: 0, b: 0 }
    var s: i64 = 0
    parallel {
        p = Pair { a: 1, b: 2 }
        s = p.a
    }
    println(str(s))
}

// === b20: параметр &mut функции в двух операторах | race
fn run(x: &mut i64) {
    parallel {
        x += 1
        x += 2
    }
}

fn main() {
    var x: i64 = 0
    run(&mut x)
    println(str(x))
}

// === b21: parallel for пишет общую переменную | race
fn main() {
    var s: i64 = 0
    parallel for i in 0..1000 {
        s += 1
    }
    println(str(s))
}

// === b22: parallel for по значениям элементов как индексам | race
fn main() {
    var out: List[i64] = repeat(i64(0), 4)
    let idx = [1, 1, 2, 3]
    parallel for i in &idx {
        out[i] += 1
    }
}

// === b23: два оператора растят разные списки | safe
fn main() {
    var a: List[i64] = []
    var b: List[i64] = []
    parallel {
        a.push(1)
        b.push(2)
    }
    println(str(len(a) + len(b)))
}

// === b24: swap двух мест и чтение одного | race
fn swap(a: &mut i64, b: &mut i64) {
    let t = a
    a = b
    b = t
}

fn main() {
    var a: i64 = 1
    var b: i64 = 2
    var c: i64 = 0
    parallel {
        swap(&mut a, &mut b)
        c = a
    }
    println(str(c))
}

// === b25: метод меняет список, вызов читает его | race
fn total(xs: &List[i64]) i64 {
    var s: i64 = 0
    for x in &xs {
        s += x
    }
    return s
}

fn main() {
    var xs: List[i64] = [1, 2]
    var s: i64 = 0
    parallel {
        xs.push(3)
        s = total(&xs)
    }
    println(str(s))
}
