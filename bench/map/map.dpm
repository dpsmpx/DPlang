// Нагрузка замера Map против std::map и std::unordered_map (О12;
// bench/map/measure.py). Фазы накопительные: build — заполнение, lookup —
// заполнение и поиск, iter — заполнение и обход, churn — заполнение,
// удаление половины и новые ключи. Тип ключа — первый аргумент (int, str),
// фаза — второй, число ключей — третий. Поиск: чётные проходы — ключи
// таблицы, нечётные — отсутствующие.
import os

fn mix(x: u64) u64 {
    var h = x *% 11400714819323198485
    h = (h ^ (h >> 31)) *% 13787848793156543929
    return h ^ (h >> 29)
}

fn ikey(i: i64) i64 {
    return i64(mix(u64(i)) >> 20)
}

fn skey(i: i64) str {
    return "key" + str(mix(u64(i)) % 1000000000)
}

fn ints(phase: str, n: i64) str {
    var m: Map[i64, i64] = []
    for i in 0..n {
        m[ikey(i)] = i
    }
    var check: i64 = 0
    if phase == "lookup" {
        for r in 0..5 {
            for i in 0..n {
                check += m.get(ikey(i + (r % 2) * n)) ?? 0
            }
        }
    }
    if phase == "iter" {
        for r in 0..20 {
            for k in &m {
                check = check +% m[k] +% k
            }
        }
    }
    if phase == "churn" {
        for i in 0..n {
            if i % 2 == 1 {
                check += m.remove(ikey(i)) ?? 0
            }
        }
        for i in n..n + n / 2 {
            m[ikey(i)] = i
        }
    }
    return str(len(m)) + " " + str(check)
}

fn strs(phase: str, n: i64) str {
    var m: Map[str, i64] = []
    for i in 0..n {
        m[skey(i)] = i
    }
    var check: i64 = 0
    if phase == "lookup" {
        for r in 0..5 {
            for i in 0..n {
                check += m.get(skey(i + (r % 2) * n)) ?? 0
            }
        }
    }
    if phase == "iter" {
        for r in 0..20 {
            for k in &m {
                check = check +% m[k] +% i64(len(k))
            }
        }
    }
    if phase == "churn" {
        for i in 0..n {
            if i % 2 == 1 {
                check += m.remove(skey(i)) ?? 0
            }
        }
        for i in n..n + n / 2 {
            m[skey(i)] = i
        }
    }
    return str(len(m)) + " " + str(check)
}

fn main() {
    let a = os.args()
    let n = parse_int(a[2]) ?? 0
    if a[0] == "int" {
        println(ints(a[1], n))
    } else {
        println(strs(a[1], n))
    }
}
