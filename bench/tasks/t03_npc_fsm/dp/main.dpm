// Драйвер t03 (скрыт от модели): тот же вывод, что у ref.cpp.
import sol

fn main() {
    let events: List[sol.Event] = [.Tick, .Tick, .Tick, .Tick, .Tick, .SeeEnemy { id: 7 }, .Tick, .SeeEnemy { id: 9 }, .LoseEnemy, .LoseEnemy, .LowHealth, .SeeEnemy { id: 3 }, .Tick, .Tick, .Tick, .Tick, .LowHealth, .LowHealth, .Tick]
    var s: sol.State = .Idle
    println(sol.describe(s))
    for e in &events {
        s = sol.step(s, e)
        println(sol.describe(s))
    }
}
