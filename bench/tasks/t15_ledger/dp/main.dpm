    step(&mut l, &mut n, "transfer alice carol_2 1")
    step(&mut l, &mut n, "begin")
    step(&mut l, &mut n, "withdraw carol_2 1000000000000000")
    step(&mut l, &mut n, "close bob")
    step(&mut l, &mut n, "withdraw bob 1")
    step(&mut l, &mut n, "close bob")
    step(&mut l, &mut n, "close b_")
    step(&mut l, &mut n, "report")
    step(&mut l, &mut n, "rollback")
    step(&mut l, &mut n, "report")
    step(&mut l, &mut n, "begin")
    step(&mut l, &mut n, "close a234567890123456")
    step(&mut l, &mut n, "open eve 10")
