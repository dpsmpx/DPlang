    step(&mut l, &mut n, "balance")
    step(&mut l, &mut n, "balance alice bob")
    step(&mut l, &mut n, "balance alice")
    step(&mut l, &mut n, "open carol_2 1000000000000000")
    step(&mut l, &mut n, "open a234567890123456 0")
    step(&mut l, &mut n, "open a2345678901234567 0")
    step(&mut l, &mut n, "open 9lives 0")
    step(&mut l, &mut n, "open dave\t1 0")
