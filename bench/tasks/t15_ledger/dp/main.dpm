    step(&mut l, &mut n, "transfer bob zed 0")
    step(&mut l, &mut n, "transfer bob bob 0")
    step(&mut l, &mut n, "transfer bob alice 3")
    step(&mut l, &mut n, "transfer alice bob 1000")
    step(&mut l, &mut n, "")
