    step(&mut l, &mut n, "deposit Bob 5")
    step(&mut l, &mut n, "deposit bob 1234567890123456789")
    step(&mut l, &mut n, "deposit bob 999999999999999999")
    step(&mut l, &mut n, "deposit bob 007")
    step(&mut l, &mut n, "withdraw bob 8")
    step(&mut l, &mut n, "withdraw alice 650")
    step(&mut l, &mut n, "withdraw alice 600")
    step(&mut l, &mut n, "transfer alice bob 50")
    step(&mut l, &mut n, "transfer bob alice 1")
    step(&mut l, &mut n, "transfer bob bob 1")
    step(&mut l, &mut n, "transfer bob alice 0")
