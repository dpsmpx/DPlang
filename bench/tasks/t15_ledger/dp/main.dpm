// Драйвер t15 (скрыт от модели): тот же вывод, что у ref.cpp.
import sol

fn step(l: &mut sol.Ledger, n: &mut i32, line: str) {
    n += 1
    println(str(n) + ": " + sol.ledger_exec(&mut l, line))
}

fn main() {
    var l = sol.ledger_new()
    var n: i32 = 0
    step(&mut l, &mut n, "report")
    step(&mut l, &mut n, "open alice 100")
    step(&mut l, &mut n, "open bob 0")
    step(&mut l, &mut n, "open alice 5")
    step(&mut l, &mut n, "  deposit   alice  500  ")
    step(&mut l, &mut n, "deposit bob 0")
    step(&mut l, &mut n, "deposit carol 5")
    step(&mut l, &mut n, "deposit bob +5")
