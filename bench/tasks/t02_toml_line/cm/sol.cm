pub enum ParseError {
    BadKey,
    MissingEquals,
    BadValue,
}

pub enum Value {
    Int(i64),
    Bool(bool),
    Str(str),
}

pub struct Entry {
    key: str,
    value: Value,
}

fn is_blank(c: u8) -> bool {
    return c == ' ' || c == '\t';
}

fn key_start(c: u8) -> bool {
    return c >= 'a' && c <= 'z' || c == '_';
}

fn key_char(c: u8) -> bool {
    return key_start(c) || is_digit(c);
}

fn skip_blank(s: str, i: int) -> int {
    var j = i;
    while j < len(s) && is_blank(s[j]) {
        j += 1;
    }
    return j;
}

// Слово w с позиции i, за которым не идёт символ ключа.
fn word_at(s: str, i: int, w: str) -> bool {
    let end = i + len(w);
    return end <= len(s) && s[i..end] == w && (end == len(s) || !key_char(s[end]));
}

pub fn parse_line(line: str) -> ParseError!?Entry {
    var i = skip_blank(line, 0);
    if i == len(line) || line[i] == '#' {
        return none;
    }
    if !key_start(line[i]) {
        fail ParseError.BadKey;
    }
    let k0 = i;
    while i < len(line) && key_char(line[i]) {
        i += 1;
    }
    let key = line[k0..i];
    // Символ, недопустимый в ключе, сразу за ключом — ошибка ключа.
    if i < len(line) && line[i] != '=' && !is_blank(line[i]) && line[i] != '#' {
        fail ParseError.BadKey;
    }
    i = skip_blank(line, i);
    if i == len(line) || line[i] != '=' {
        fail ParseError.MissingEquals;
    }
    i = skip_blank(line, i + 1);
    if i == len(line) {
        fail ParseError.BadValue;
    }
    var value = Value.Bool(false);
    if line[i] == '"' {
        var j = i + 1;
        while j < len(line) && line[j] != '"' {
            j += 1;
        }
        if j == len(line) {
            fail ParseError.BadValue;
        }
        value = Value.Str(line[i + 1..j]);
        i = j + 1;
    } else if word_at(line, i, "true") {
        value = Value.Bool(true);
        i += 4;
    } else if word_at(line, i, "false") {
        i += 5;
    } else {
        let start = i;
        if line[i] == '-' {
            i += 1;
        }
        while i < len(line) && is_digit(line[i]) {
            i += 1;
        }
        if let n = parse_int(line[start..i]) {
            value = Value.Int(n);
        } else {
            fail ParseError.BadValue;
        }
    }
    let rest = skip_blank(line, i);
    if rest != len(line) && line[rest] != '#' {
        fail ParseError.BadValue;
    }
    return Entry { key, value };
}
