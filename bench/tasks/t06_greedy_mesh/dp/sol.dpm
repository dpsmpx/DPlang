pub struct Quad {
    x: i32
    y: i32
    w: i32
    h: i32
    block: i32
}

fn free_eq(cells: []i32, seen: &List[bool], w: i32, x: i32, y: i32, b: i32) bool {
    return cells[y * w + x] == b && !seen[y * w + x]
}

fn row_free(cells: []i32, seen: &List[bool], w: i32, x: i32, y: i32, wd: i32, b: i32) bool {
    for i in 0..wd {
        if !free_eq(cells, &seen, w, x + i, y, b) {
            return false
        }
    }
    return true
}

pub fn greedy_mesh(w: i32, h: i32, cells: []i32) List[Quad] {
    var seen = repeat(false, len(cells))
    var out: List[Quad] = []
    for y in 0..h {
        for x in 0..w {
            let b = cells[y * w + x]
            if b == 0 || seen[y * w + x] {
                continue
            }
            var wd: i32 = 1
            while x + wd < w && free_eq(cells, &seen, w, x + wd, y, b) {
                wd += 1
            }
            var ht: i32 = 1
            while y + ht < h && row_free(cells, &seen, w, x, y + ht, wd, b) {
                ht += 1
            }
            for j in 0..ht {
                for i in 0..wd {
                    seen[(y + j) * w + x + i] = true
                }
            }
            out.push(Quad { x, y, w: wd, h: ht, block: b })
        }
    }
    return out
}
