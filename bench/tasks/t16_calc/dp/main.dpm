// Драйвер t16 (скрыт от модели): тот же вывод, что у ref.cpp.
import sol

fn show(src: str) {
    println("[" + src + "] => " + sol.calc(src))
}

fn main() {
    show("1 + 2 * 3")
    show("(1 + 2) * 3")
    show("7 - 2 - 3")
    show("100 / 7 / 2")
    show("-7 / 2")
    show("-7 % 2")
    show("7 % -2")
    show("2 ^ 3 ^ 2")
    show("-2 ^ 2")
    show("(-2) ^ 2")
    show("2 ^ -1")
    show("2 ^ - 1 + x")
    show("0 ^ 0")
    show("1 ^ 1000000000000")
    show("-1 ^ 1000000000001")
    show("(-1) ^ 1000000000001")
    show("(-2) ^ 63")
    show("2 ^ 63")
    show("2 ^ 62 + (2 ^ 62 - 1)")
    show("--3")
    show("- - 3 - -3")
    show("9223372036854775807")
    show("9223372036854775808")
    show("-9223372036854775808")
    show("-9223372036854775807 - 1")
    show("-9223372036854775807 - 2")
    show("x = -9223372036854775807 - 1; x / -1")
    show("x = -9223372036854775807 - 1; x % -1")
    show("x = -9223372036854775807 - 1; -x")
    show("x = -9223372036854775807 - 1; x * -1")
    show("3037000500 * 3037000500")
    show("3037000499 * 3037000499")
    show("x = 5; y = x * 2; y + x")
    show("x = 1; x = x + 1; x = x * 10; x")
    show("a = b = 3")
    show("x = 4")
    show("_tmp = 3; _tmp2 = _tmp ^ 2; _tmp2")
    show("x + 1")
    show("1 / 0 + x")
    show("x + 1 / 0")
    show("y = 1 / 0; z")
    show("5 % 0")
    show("1 / (2 - 2)")
    show("")
    show("   ")
    show("1 +")
    show("1 + ")
    show("(1 + 2")
    show("(1 + 2 ")
    show("(1 2)")
    show("(1 + )")
    show("()")
    show("1 2")
    show("2x")
    show("x y")
    show("1 + * 2")
    show("1 ; ; 2")
    show("1;")
    show(";")
    show("= 3")
    show("x =")
    show("1 + 2 $ 3")
    show("1 2 $")
    show("(1 $")
    show("1 + Abc")
    show("99999999999999999999 + 1")
    show("1 2 99999999999999999999")
    show("(4 + 5) * (2 - 7) ^ 2 % 1000 - -(3)")
    show("a=2;b=a^a^a;b%1000003")
    show("   42   ")
    show("y + 1; y = 2")
    show("x = 2; x ^ 62 * 2")
    show("10 % 3 ^ 2")
}
