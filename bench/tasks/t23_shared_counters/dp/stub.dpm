fn mix(x: u64) u64 {
    var z = x +% 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
    return z ^ (z >> 31)
}

pub fn cost(v: i64) i64 {
    var h = u64(v)
    for i in 0..2000 {
        h = mix(h)
    }
    return i64(h % 1000)
}

pub struct Totals {
    ok: bool
    bad: i64
    count: i64
    sum: i64
    odd: i64
}

