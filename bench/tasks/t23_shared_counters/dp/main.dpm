// Драйвер t23 (скрыт от модели): те же входы, что у ref.cpp.
import sol

fn mix(x: u64) u64 {
    var z = x +% 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
    return z ^ (z >> 31)
}

fn show(name: str, t: &sol.Totals) {
    println(name + " ok=" + str(t.ok) + " bad=" + str(t.bad) + " count=" + str(t.count) + " sum=" + str(t.sum) + " odd=" + str(t.odd))
}

fn main() {
    var jobs: List[i64] = []
    for i in 0..20000 {
        jobs.push(i64(mix(u64(i)) >> 2))
    }
    let ws: List[i32] = [1, 4, 8]
    for w in &ws {
        let t = sol.run_jobs(&jobs, w)
        show("w=" + str(w), &t)
    }
    jobs[15000] = -5
    jobs[12345] = -1
    let bs: List[i32] = [1, 3, 8]
    for w in &bs {
        let t = sol.run_jobs(&jobs, w)
        show("bad w=" + str(w), &t)
    }
    let empty: List[i64] = []
    let e = sol.run_jobs(&empty, 2)
    show("empty", &e)
    let one: List[i64] = [-1]
    let o = sol.run_jobs(&one, 3)
    show("one", &o)
    let small: List[i64] = [5, -2, 7, -3]
    let s = sol.run_jobs(&small, 2)
    show("small", &s)
    let tiny: List[i64] = [1, 2, 3]
    let t = sol.run_jobs(&tiny, 5)
    show("tiny", &t)
}
