// Драйвер t08 (скрыт от модели): тот же вывод, что у ref.cpp.
import sol

fn run(boxes: []sol.Box, print_pairs: bool) {
    let pairs = sol.overlapping_pairs(boxes)
    println("pairs " + str(len(pairs)))
    if print_pairs {
        for p in &pairs {
            println("  " + str(p.i) + " " + str(p.j))
        }
    }
}

fn b(min_x: i32, min_y: i32, max_x: i32, max_y: i32) sol.Box {
    return sol.Box { min_x, min_y, max_x, max_y }
}

// Линейный конгруэнтный генератор драйвера ref.cpp.
fn next(s: &mut u32) i32 {
    s = s *% 1103515245 +% 12345
    return i32((s >> 16) & 32767)
}

fn main() {
    let one = [b(0, 0, 2, 2), b(1, 1, 3, 3), b(2, 0, 4, 2), b(5, 5, 6, 6)]
    run(one, true)
    let two = [b(0, 0, 10, 10), b(1, 1, 2, 2), b(8, 8, 9, 9), b(10, 0, 11, 1)]
    run(two, true)
    let empty: List[sol.Box] = []
    run(empty, true)
    var many: List[sol.Box] = []
    var s: u32 = 12345
    for i in 0..200 {
        let x = next(&mut s) % 1000
        let y = next(&mut s) % 1000
        let w = 1 + next(&mut s) % 60
        let h = 1 + next(&mut s) % 60
        many.push(b(x, y, x + w, y + h))
    }
    let pairs = sol.overlapping_pairs(many)
    var sum: i64 = 0
    for p in &pairs {
        sum += i64(p.i) * 1000 + i64(p.j)
    }
    println("pairs " + str(len(pairs)) + " checksum " + str(sum))
}
