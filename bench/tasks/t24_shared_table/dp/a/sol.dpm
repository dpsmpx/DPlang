pub struct Move {
    from: i32
    to: i32
    amount: i64
}

pub struct Report {
    table: List[i64]
    reads: i64
    bad: i64
}

// Писатель: переводы по порядку, каждый — под блокировкой таблицы.
fn writer(table: &Mutex[List[i64]], moves: &List[Move]) {
    for mv in &moves {
        lock table as t {
            let a = min(mv.amount, t[mv.from])
            t[mv.from] -= a
            t[mv.to] += a
        }
    }
}

// Читатель: сумма таблицы под блокировкой; неверные — в out.
fn reader(table: &Mutex[List[i64]], reads: i32, total: i64, out: &mut i64) {
    var bad: i64 = 0
    for k in 0..reads {
        lock table as t {
            var s: i64 = 0
            for v in &t {
                s += v
            }
            if s != total {
                bad += 1
            }
        }
    }
    out = bad
}

// Вариант А: писатель и читатели — задачи блока; таблица — по `&`.
pub fn run_bank(accounts: i32, moves: &List[Move], readers: i32, reads: i32) Report {
    let table = mutex(repeat(i64(1000), accounts))
    let total = i64(accounts) * 1000
    var bads: List[i64] = repeat(i64(0), readers)
    tasks {
        spawn writer(&table, &moves)
        for r in 0..readers {
            spawn reader(&table, reads, total, &mut bads[r])
        }
    }
    var bad: i64 = 0
    for b in &bads {
        bad += b
    }
    var out: List[i64] = []
    lock table as t {
        out = t
    }
    return Report { table: out, reads: i64(readers) * i64(reads), bad }
}
