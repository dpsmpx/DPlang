// t15: книга счетов с вложенными транзакциями.
const MAX_ABS: i64 = 1000000000000000
const MAX_DEPTH: int = 8

pub struct Ledger {
    // баланс и кредитный лимит открытых счетов
    bal: Map[str, i64]
    lim: Map[str, i64]
    // снимки на момент каждого begin
    saved_bal: List[Map[str, i64]]
    saved_lim: List[Map[str, i64]]
}

pub fn ledger_new() Ledger {
    let b: Map[str, i64] = []
    let m: Map[str, i64] = []
    let sb: List[Map[str, i64]] = []
    let sm: List[Map[str, i64]] = []
    return Ledger { bal: b, lim: m, saved_bal: sb, saved_lim: sm }
}

fn words(s: str) List[str] {
    var out: List[str] = []
    for part in &s.split(" ") {
        if len(part) > 0 {
            out.push(part)
        }
    }
    return out
}

fn valid_name(s: str) bool {
    let n = len(s)
    if n < 1 || n > 16 {
        return false
    }
    for i in 0..n {
        let c = s[i]
        if c >= 'a' && c <= 'z' {
            continue
        }
        if i > 0 && ((c >= '0' && c <= '9') || c == '_') {
            continue
        }
        return false
    }
    return true
}

fn parse_num(s: str) ?i64 {
    let n = len(s)
    if n < 1 || n > 18 {
        return none
    }
    var v: i64 = 0
    for i in 0..n {
        let c = s[i]
        if c < '0' || c > '9' {
            return none
        }
        v = v * 10 + i64(c - '0')
    }
    return v
}

fn out_of_bound(v: i64) bool {
    return v > MAX_ABS || v < -MAX_ABS
}

fn do_open(l: &mut Ledger, name: str, limit: i64) str {
    if l.bal.contains(name) {
        return "error exists " + name
    }
    l.bal[name] = 0
    l.lim[name] = limit
    return "ok"
}

fn do_deposit(l: &mut Ledger, name: str, amt: i64) str {
    if amt == 0 {
        return "error amount"
    }
    if !l.bal.contains(name) {
        return "error unknown " + name
    }
    let nb = l.bal[name] + amt
    if nb < -l.lim[name] {
        return "error funds"
    }
    if out_of_bound(nb) {
        return "error bound"
    }
    l.bal[name] = nb
    return "ok " + str(nb)
}

fn do_withdraw(l: &mut Ledger, name: str, amt: i64) str {
    if amt == 0 {
        return "error amount"
    }
    if !l.bal.contains(name) {
        return "error unknown " + name
    }
    let nb = l.bal[name] - amt
    if nb < -l.lim[name] {
        return "error funds"
    }
    if out_of_bound(nb) {
        return "error bound"
    }
    l.bal[name] = nb
    return "ok " + str(nb)
}

fn do_transfer(l: &mut Ledger, src: str, dst: str, amt: i64) str {
    if amt == 0 {
        return "error amount"
    }
    if !l.bal.contains(src) {
        return "error unknown " + src
    }
    if !l.bal.contains(dst) {
        return "error unknown " + dst
    }
    if src == dst {
        return "error same"
    }
    var fee = amt / 100
    if fee < 1 {
        fee = 1
    }
    let nf = l.bal[src] - amt - fee
    let nt = l.bal[dst] + amt
    if nf < -l.lim[src] {
        return "error funds"
    }
    if out_of_bound(nf) || out_of_bound(nt) {
        return "error bound"
    }
    l.bal[src] = nf
    l.bal[dst] = nt
    return "ok " + str(nf) + " " + str(nt)
}

fn do_report(l: &Ledger) str {
    var names: List[str] = []
    for k in &l.bal {
        names.push(k)
    }
    if len(names) == 0 {
        return "(empty)"
    }
    names.sort()
    var out = ""
    for i in 0..len(names) {
        if i > 0 {
            out += " "
        }
        out += names[i] + ":" + str(l.bal[names[i]])
    }
    return out
}

pub fn ledger_exec(l: &mut Ledger, line: str) str {
    let w = words(line)
    if len(w) == 0 {
        return "error syntax"
    }
    let cmd = w[0]
    let argc = len(w) - 1
    if cmd == "open" {
        if argc != 2 || !valid_name(w[1]) {
            return "error syntax"
        }
        if let limit = parse_num(w[2]) {
            return do_open(&mut l, w[1], limit)
        }
        return "error syntax"
    }
    if cmd == "deposit" || cmd == "withdraw" {
        if argc != 2 || !valid_name(w[1]) {
            return "error syntax"
        }
        if let amt = parse_num(w[2]) {
            if cmd == "deposit" {
                return do_deposit(&mut l, w[1], amt)
            }
            return do_withdraw(&mut l, w[1], amt)
        }
        return "error syntax"
    }
    if cmd == "transfer" {
        if argc != 3 || !valid_name(w[1]) || !valid_name(w[2]) {
            return "error syntax"
        }
        if let tamt = parse_num(w[3]) {
            return do_transfer(&mut l, w[1], w[2], tamt)
        }
        return "error syntax"
    }
    if cmd == "balance" {
        if argc != 1 || !valid_name(w[1]) {
            return "error syntax"
        }
        let bname = w[1]
        if let b = l.bal.get(bname) {
            return str(b)
        }
        return "error unknown " + bname
    }
    if cmd == "close" {
        if argc != 1 || !valid_name(w[1]) {
            return "error syntax"
        }
        let cname = w[1]
        if !l.bal.contains(cname) {
            return "error unknown " + cname
        }
        if l.bal[cname] != 0 {
            return "error nonzero"
        }
        _ = l.bal.remove(cname)
        _ = l.lim.remove(cname)
        return "ok"
    }
    if cmd == "begin" {
        if argc != 0 {
            return "error syntax"
        }
        if len(l.saved_bal) >= MAX_DEPTH {
            return "error depth"
        }
        let snap_bal = l.bal
        let snap_lim = l.lim
        l.saved_bal.push(snap_bal)
        l.saved_lim.push(snap_lim)
        return "ok depth " + str(len(l.saved_bal))
    }
    if cmd == "commit" {
        if argc != 0 {
            return "error syntax"
        }
        if len(l.saved_bal) == 0 {
            return "error depth"
        }
        _ = l.saved_bal.pop()
        _ = l.saved_lim.pop()
        return "ok depth " + str(len(l.saved_bal))
    }
    if cmd == "rollback" {
        if argc != 0 {
            return "error syntax"
        }
        if len(l.saved_bal) == 0 {
            return "error depth"
        }
        if let rb = l.saved_bal.pop() {
            l.bal = rb
        }
        if let rl = l.saved_lim.pop() {
            l.lim = rl
        }
        return "ok depth " + str(len(l.saved_bal))
    }
    if cmd == "report" {
        if argc != 0 {
            return "error syntax"
        }
        return do_report(&l)
    }
    return "error syntax"
}
