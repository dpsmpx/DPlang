// t01: кольцевой буфер целых.
pub enum RingError {
    Full
}

pub struct Ring {
    data: List[i32]
    head: int
    count: int
    cap: int
}

pub fn ring_new(capacity: i32) Ring {
    let zero: i32 = 0
    let n: int = capacity
    return Ring { data: repeat(zero, n), head: 0, count: 0, cap: n }
}

pub fn ring_push(r: &mut Ring, value: i32) RingError!void {
    if r.count >= r.cap {
        fail RingError.Full
    }
    let idx = (r.head + r.count) % r.cap
    r.data[idx] = value
    r.count += 1
}

pub fn ring_pop(r: &mut Ring) ?i32 {
    if r.count == 0 {
        return none
    }
    let v = r.data[r.head]
    r.head = (r.head + 1) % r.cap
    r.count -= 1
    return v
}

pub fn ring_len(r: &Ring) i32 {
    return i32(r.count)
}
