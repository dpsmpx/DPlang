// t15: книга счетов с вложенными транзакциями.

const BOUND: i64 = 1000000000000000
const MAX_DEPTH: int = 8

pub struct Account {
    name: str
    limit: i64
    bal: i64
}

pub struct Ledger {
    // открытые счета
    accounts: List[Account]
    // состояние счетов на момент каждого незавершённого begin
    snaps: List[List[Account]]
}

pub fn ledger_new() Ledger {
    return Ledger { accounts: [], snaps: [] }
}

// Слова строки: разделитель — только пробел.
fn split_words(line: str) List[str] {
    var words: List[str] = []
    var i: int = 0
    let n = len(line)
    while i < n {
        if line[i] == ' ' {
            i += 1
            continue
        }
        var j = i
        while j < n && line[j] != ' ' {
            j += 1
        }
        words.push(line[i..j])
        i = j
    }
    return words
}

fn valid_name(w: str) bool {
    let n = len(w)
    if n < 1 || n > 16 {
        return false
    }
    if w[0] < 'a' || w[0] > 'z' {
        return false
    }
    for k in 1..n {
        let c = w[k]
        let good = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_'
        if !good {
            return false
        }
    }
    return true
}

// Число от 1 до 18 цифр; иначе none.
fn parse_num(w: str) ?i64 {
    let n = len(w)
    if n < 1 || n > 18 {
        return none
    }
    var v: i64 = 0
    for c in &w {
        if c < '0' || c > '9' {
            return none
        }
        v = v * 10 + i64(c - '0')
    }
    return v
}

fn find_acc(l: &Ledger, name: str) ?int {
    for i in 0..len(l.accounts) {
        if l.accounts[i].name == name {
            return i
        }
    }
    return none
}

fn cmd_open(l: &mut Ledger, w: &List[str]) str {
    if len(w) != 3 || !valid_name(w[1]) {
        return "error syntax"
    }
    let lim = parse_num(w[2]) ?? -1
    if lim < 0 {
        return "error syntax"
    }
    if find_acc(&l, w[1]) != none {
        return "error exists " + w[1]
    }
    l.accounts.push(Account { name: w[1], limit: lim, bal: 0 })
    return "ok"
}

fn cmd_move(l: &mut Ledger, w: &List[str], is_withdraw: bool) str {
    if len(w) != 3 || !valid_name(w[1]) {
        return "error syntax"
    }
    let amt = parse_num(w[2]) ?? -1
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    let idx = find_acc(&l, w[1]) ?? -1
    if idx < 0 {
        return "error unknown " + w[1]
    }
    let cur = l.accounts[idx].bal
    var nb: i64 = cur + amt
    if is_withdraw {
        nb = cur - amt
        if nb < -l.accounts[idx].limit {
            return "error funds"
        }
    }
    if abs(nb) > BOUND {
        return "error bound"
    }
    l.accounts[idx].bal = nb
    return "ok " + str(nb)
}

fn cmd_transfer(l: &mut Ledger, w: &List[str]) str {
    if len(w) != 4 || !valid_name(w[1]) || !valid_name(w[2]) {
        return "error syntax"
    }
    let amt = parse_num(w[3]) ?? -1
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    let fi = find_acc(&l, w[1]) ?? -1
    if fi < 0 {
        return "error unknown " + w[1]
    }
    let ti = find_acc(&l, w[2]) ?? -1
    if ti < 0 {
        return "error unknown " + w[2]
    }
    if fi == ti {
        return "error same"
    }
    var fee: i64 = amt / 100
    if fee < 1 {
        fee = 1
    }
    let nf = l.accounts[fi].bal - amt - fee
    let nt = l.accounts[ti].bal + amt
    if nf < -l.accounts[fi].limit {
        return "error funds"
    }
    if abs(nf) > BOUND {
        return "error bound"
    }
    if abs(nt) > BOUND {
        return "error bound"
    }
    l.accounts[fi].bal = nf
    l.accounts[ti].bal = nt
    return "ok " + str(nf) + " " + str(nt)
}

fn cmd_balance(l: &Ledger, w: &List[str]) str {
    if len(w) != 2 || !valid_name(w[1]) {
        return "error syntax"
    }
    let idx = find_acc(&l, w[1]) ?? -1
    if idx < 0 {
        return "error unknown " + w[1]
    }
    return str(l.accounts[idx].bal)
}

fn cmd_close(l: &mut Ledger, w: &List[str]) str {
    if len(w) != 2 || !valid_name(w[1]) {
        return "error syntax"
    }
    let idx = find_acc(&l, w[1]) ?? -1
    if idx < 0 {
        return "error unknown " + w[1]
    }
    if l.accounts[idx].bal != 0 {
        return "error nonzero"
    }
    _ = l.accounts.remove(idx)
    return "ok"
}

fn cmd_begin(l: &mut Ledger) str {
    if len(l.snaps) >= MAX_DEPTH {
        return "error depth"
    }
    let snap = l.accounts
    l.snaps.push(snap)
    return "ok depth " + str(len(l.snaps))
}

fn cmd_commit(l: &mut Ledger) str {
    if len(l.snaps) == 0 {
        return "error depth"
    }
    _ = l.snaps.pop()
    return "ok depth " + str(len(l.snaps))
}

fn cmd_rollback(l: &mut Ledger) str {
    if len(l.snaps) == 0 {
        return "error depth"
    }
    if let snap = l.snaps.pop() {
        l.accounts = snap
    }
    return "ok depth " + str(len(l.snaps))
}

fn cmd_report(l: &Ledger) str {
    if len(l.accounts) == 0 {
        return "(empty)"
    }
    var sorted = l.accounts
    sorted.sort()
    var out = ""
    for i in 0..len(sorted) {
        if i > 0 {
            out += " "
        }
        out += sorted[i].name + ":" + str(sorted[i].bal)
    }
    return out
}

pub fn ledger_exec(l: &mut Ledger, line: str) str {
    let w = split_words(line)
    if len(w) == 0 {
        return "error syntax"
    }
    let cmd = w[0]
    if cmd == "open" {
        return cmd_open(&mut l, &w)
    }
    if cmd == "deposit" {
        return cmd_move(&mut l, &w, false)
    }
    if cmd == "withdraw" {
        return cmd_move(&mut l, &w, true)
    }
    if cmd == "transfer" {
        return cmd_transfer(&mut l, &w)
    }
    if cmd == "balance" {
        return cmd_balance(&l, &w)
    }
    if cmd == "close" {
        return cmd_close(&mut l, &w)
    }
    if cmd == "begin" || cmd == "commit" || cmd == "rollback" || cmd == "report" {
        if len(w) != 1 {
            return "error syntax"
        }
        if cmd == "begin" {
            return cmd_begin(&mut l)
        }
        if cmd == "commit" {
            return cmd_commit(&mut l)
        }
        if cmd == "rollback" {
            return cmd_rollback(&mut l)
        }
        return cmd_report(&l)
    }
    return "error syntax"
}
