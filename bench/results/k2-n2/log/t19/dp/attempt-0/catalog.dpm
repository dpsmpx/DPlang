// Модуль catalog (до рефакторинга): товары по номерам.
pub struct Item {
    code: str
    // копейки
    price: i64
}

pub struct Catalog {
    // номер товара — индекс
    items: List[Item]
}

// Добавляет товар; его номер или -1, если код уже есть.
pub fn catalog_add(c: &mut Catalog, code: str, price: i64) i32 {
    if catalog_find(&c, code) >= 0 {
        return -1
    }
    c.items.push(Item { code, price })
    return i32(len(c.items) - 1)
}

// Номер товара по коду или -1.
pub fn catalog_find(c: &Catalog, code: str) i32 {
    for i in 0..len(c.items) {
        if c.items[i].code == code {
            return i32(i)
        }
    }
    return -1
}

pub fn catalog_price(c: &Catalog, item: i32) i64 {
    return c.items[item].price
}

pub fn catalog_code(c: &Catalog, item: i32) str {
    return c.items[item].code
}
