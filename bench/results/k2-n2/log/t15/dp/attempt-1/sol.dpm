// t15: книга счетов с вложенными транзакциями.

pub struct Account {
    bal: i64
    limit: i64
}

pub struct Ledger {
    // открытые счета по имени
    accts: Map[str, Account]
    // снимки счетов на момент каждого begin
    stack: List[Map[str, Account]]
}

const BOUND: i64 = 1000000000000000
const MAX_DEPTH: int = 8

pub fn ledger_new() Ledger {
    return Ledger { accts: [], stack: [] }
}

fn words(s: str) List[str] {
    var out: List[str] = []
    for w in &s.split(" ") {
        if len(w) > 0 {
            out.push(w)
        }
    }
    return out
}

fn valid_name(s: str) bool {
    let n = len(s)
    if n < 1 || n > 16 {
        return false
    }
    for i in 0..n {
        let c = s[i]
        if c >= 'a' && c <= 'z' {
            continue
        }
        if i > 0 && (is_digit(c) || c == '_') {
            continue
        }
        return false
    }
    return true
}

// Число из 1..18 десятичных цифр; иначе -1.
fn parse_num(s: str) i64 {
    let n = len(s)
    if n < 1 || n > 18 {
        return -1
    }
    var v: i64 = 0
    for c in &s {
        if !is_digit(c) {
            return -1
        }
        v = v * 10 + i64(c - '0')
    }
    return v
}

fn out_of_bound(v: i64) bool {
    return v > BOUND || v < -BOUND
}

fn cmd_open(l: &mut Ledger, ws: &List[str]) str {
    if len(ws) != 3 {
        return "error syntax"
    }
    if !valid_name(ws[1]) {
        return "error syntax"
    }
    let lim = parse_num(ws[2])
    if lim < 0 {
        return "error syntax"
    }
    let name = ws[1]
    if l.accts.contains(name) {
        return "error exists " + name
    }
    l.accts[name] = Account { bal: 0, limit: lim }
    return "ok"
}

fn cmd_deposit(l: &mut Ledger, ws: &List[str]) str {
    if len(ws) != 3 {
        return "error syntax"
    }
    if !valid_name(ws[1]) {
        return "error syntax"
    }
    let amt = parse_num(ws[2])
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    let name = ws[1]
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    var a = l.accts[name]
    let nb = a.bal + amt
    if nb < -a.limit {
        return "error funds"
    }
    if out_of_bound(nb) {
        return "error bound"
    }
    a.bal = nb
    l.accts[name] = a
    return "ok " + str(nb)
}

fn cmd_withdraw(l: &mut Ledger, ws: &List[str]) str {
    if len(ws) != 3 {
        return "error syntax"
    }
    if !valid_name(ws[1]) {
        return "error syntax"
    }
    let amt = parse_num(ws[2])
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    let name = ws[1]
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    var a = l.accts[name]
    let nb = a.bal - amt
    if nb < -a.limit {
        return "error funds"
    }
    if out_of_bound(nb) {
        return "error bound"
    }
    a.bal = nb
    l.accts[name] = a
    return "ok " + str(nb)
}

fn cmd_transfer(l: &mut Ledger, ws: &List[str]) str {
    if len(ws) != 4 {
        return "error syntax"
    }
    if !valid_name(ws[1]) {
        return "error syntax"
    }
    if !valid_name(ws[2]) {
        return "error syntax"
    }
    let amt = parse_num(ws[3])
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    let src_name = ws[1]
    let dst_name = ws[2]
    if !l.accts.contains(src_name) {
        return "error unknown " + src_name
    }
    if !l.accts.contains(dst_name) {
        return "error unknown " + dst_name
    }
    if src_name == dst_name {
        return "error same"
    }
    var fee = amt / 100
    if fee < 1 {
        fee = 1
    }
    var sa = l.accts[src_name]
    var da = l.accts[dst_name]
    let nsrc = sa.bal - (amt + fee)
    let ndst = da.bal + amt
    if nsrc < -sa.limit {
        return "error funds"
    }
    if ndst < -da.limit {
        return "error funds"
    }
    if out_of_bound(nsrc) {
        return "error bound"
    }
    if out_of_bound(ndst) {
        return "error bound"
    }
    sa.bal = nsrc
    da.bal = ndst
    l.accts[src_name] = sa
    l.accts[dst_name] = da
    return "ok " + str(nsrc) + " " + str(ndst)
}

fn cmd_balance(l: &Ledger, ws: &List[str]) str {
    if len(ws) != 2 {
        return "error syntax"
    }
    if !valid_name(ws[1]) {
        return "error syntax"
    }
    let name = ws[1]
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    let a = l.accts[name]
    return str(a.bal)
}

fn cmd_close(l: &mut Ledger, ws: &List[str]) str {
    if len(ws) != 2 {
        return "error syntax"
    }
    if !valid_name(ws[1]) {
        return "error syntax"
    }
    let name = ws[1]
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    let a = l.accts[name]
    if a.bal != 0 {
        return "error nonzero"
    }
    _ = l.accts.remove(name)
    return "ok"
}

fn cmd_begin(l: &mut Ledger) str {
    if len(l.stack) >= MAX_DEPTH {
        return "error depth"
    }
    let snap = l.accts
    l.stack.push(snap)
    return "ok depth " + str(len(l.stack))
}

fn cmd_commit(l: &mut Ledger) str {
    if len(l.stack) == 0 {
        return "error depth"
    }
    _ = l.stack.pop()
    return "ok depth " + str(len(l.stack))
}

fn cmd_rollback(l: &mut Ledger) str {
    if let snap = l.stack.pop() {
        l.accts = snap
        return "ok depth " + str(len(l.stack))
    }
    return "error depth"
}

fn cmd_report(l: &Ledger) str {
    if len(l.accts) == 0 {
        return "(empty)"
    }
    var out = ""
    var first = true
    for k in &l.accts {
        let a = l.accts[k]
        if !first {
            out += " "
        }
        first = false
        out += k + ":" + str(a.bal)
    }
    return out
}

pub fn ledger_exec(l: &mut Ledger, line: str) str {
    let w = words(line)
    if len(w) == 0 {
        return "error syntax"
    }
    let cmd = w[0]
    if cmd == "open" {
        return cmd_open(&mut l, &w)
    }
    if cmd == "deposit" {
        return cmd_deposit(&mut l, &w)
    }
    if cmd == "withdraw" {
        return cmd_withdraw(&mut l, &w)
    }
    if cmd == "transfer" {
        return cmd_transfer(&mut l, &w)
    }
    if cmd == "balance" {
        return cmd_balance(&l, &w)
    }
    if cmd == "close" {
        return cmd_close(&mut l, &w)
    }
    if cmd == "begin" {
        if len(w) != 1 {
            return "error syntax"
        }
        return cmd_begin(&mut l)
    }
    if cmd == "commit" {
        if len(w) != 1 {
            return "error syntax"
        }
        return cmd_commit(&mut l)
    }
    if cmd == "rollback" {
        if len(w) != 1 {
            return "error syntax"
        }
        return cmd_rollback(&mut l)
    }
    if cmd == "report" {
        if len(w) != 1 {
            return "error syntax"
        }
        return cmd_report(&l)
    }
    return "error syntax"
}
