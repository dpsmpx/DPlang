// t24: заготовка — напишите тело функции по task.md.
pub struct Move {
    from: i32
    to: i32
    amount: i64
}

pub struct Report {
    table: List[i64]
    reads: i64
    bad: i64
}

fn writer(m: &Mutex[List[i64]], moves: &List[Move]) {
    for mv in &moves {
        if mv.from != mv.to {
            let a = int(mv.from)
            let b = int(mv.to)
            lock m as t {
                let x = min(mv.amount, t[a])
                t[a] -= x
                t[b] += x
            }
        }
    }
}

fn reader(m: &Mutex[List[i64]], reads: i32, expect: i64, out: &mut i64) {
    var bad: i64 = 0
    for i in 0..reads {
        var s: i64 = 0
        lock m as t {
            for v in &t {
                s += v
            }
        }
        if s != expect {
            bad += 1
        }
    }
    out = bad
}

pub fn run_bank(accounts: i32, moves: &List[Move], readers: i32, reads: i32) Report {
    let m: Mutex[List[i64]] = mutex(repeat(i64(1000), int(accounts)))
    let nr = int(readers)
    let expect = i64(accounts) * 1000
    var bads: List[i64] = repeat(i64(0), nr)
    tasks {
        spawn writer(&m, &moves)
        for r in 0..nr {
            spawn reader(&m, reads, expect, &mut bads[r])
        }
    }
    var table: List[i64] = []
    lock m as t {
        table = t
    }
    var bad: i64 = 0
    for x in &bads {
        bad += x
    }
    return Report { table, reads: i64(readers) * i64(reads), bad }
}
