// t20: заготовка — напишите тело run по task.md.
pub fn mix(x: u64) u64 {
    var z = x +% 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
    return z ^ (z >> 31)
}

pub fn build(chunk: i64, seed: u64) i64 {
    var h = u64.wrap(chunk) ^ seed
    for i in 0..20000 {
        h = mix(h)
    }
    return i64(h % 100000)
}

pub struct Cmd {
    kind: i32
    chunk: i64
    seed: u64
}

// Заказ на сборку: номер заказа, чанк, зерно.
struct Job {
    id: i64
    chunk: i64
    seed: u64
}

// Готовый результат сборки.
struct Done {
    id: i64
    chunk: i64
    value: i64
}

// Рабочий: берёт заказы из канала, собирает, отдаёт результат.
// После ухода менеджера (флаг stop) оставшиеся заказы не собирает.
fn worker(jobs: &Channel[Job], results: &Channel[Done], stop: &Atomic[bool]) {
    while true {
        if let j = jobs.recv() {
            if stop.load() {
                continue
            }
            let v = build(j.chunk, j.seed)
            results.send(Done { id: j.id, chunk: j.chunk, value: v })
        } else {
            break
        }
    }
}

// Применить результат, если заказ не устарел.
fn apply(latest: &Map[i64, i64], vals: &mut Map[i64, i64], d: Done) {
    if latest.get(d.chunk) == d.id {
        vals[d.chunk] = d.value
    }
}

// Игровой цикл: исполняет команды сценария.
fn manage(script: &List[Cmd], limit: i32, jobs: &Channel[Job], results: &Channel[Done], stop: &Atomic[bool], out: &mut List[str]) {
    var next_id: i64 = 0
    var pending: i64 = 0
    var syncs: i64 = 0
    var latest: Map[i64, i64] = []
    var vals: Map[i64, i64] = []
    for c in &script {
        if c.kind == 0 {
            next_id += 1
            latest[c.chunk] = next_id
            jobs.send(Job { id: next_id, chunk: c.chunk, seed: c.seed })
            pending += 1
        } else if c.kind == 1 {
            var taken: i32 = 0
            while taken < limit {
                if let r1 = results.try_recv() {
                    pending -= 1
                    taken += 1
                    apply(&latest, &mut vals, r1)
                } else {
                    break
                }
            }
        } else if c.kind == 2 {
            while pending > 0 {
                if let r2 = results.recv() {
                    pending -= 1
                    apply(&latest, &mut vals, r2)
                } else {
                    break
                }
            }
            syncs += 1
            var line = "sync " + str(syncs) + ":"
            for k in &vals {
                line += " " + str(k) + "=" + str(vals[k])
            }
            out.push(line)
        } else if c.kind == 3 {
            break
        }
    }
    stop.store(true)
    jobs.close()
}

pub fn run(script: &List[Cmd], limit: i32) List[str] {
    var orders: int = 0
    for c in &script {
        if c.kind == 0 {
            orders += 1
        }
    }
    // Ёмкости хватает на все заказы: отправка никогда не ждёт.
    let cap = max(1, orders)
    let jobs: Channel[Job] = channel(cap)
    let results: Channel[Done] = channel(cap)
    let stop = atomic(false)
    var out: List[str] = []
    parallel {
        manage(&script, limit, &jobs, &results, &stop, &mut out)
        worker(&jobs, &results, &stop)
        worker(&jobs, &results, &stop)
        worker(&jobs, &results, &stop)
    }
    return out
}
