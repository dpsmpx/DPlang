// t05: заготовка — напишите тела функций по task.md.
const GOLDEN u64 = 0x9E3779B97F4A7C15
const MIX1 u64 = 0xBF58476D1CE4E5B9
const MIX2 u64 = 0x94D049BB133111EB

pub fn hash32(seed u64, x i32, y i32) u32 {
    var hx u64 = u64(u32.wrap(x))
    var hy u64 = u64(u32.wrap(y))
    var k u64 = seed ^ (hx << 32) ^ hy
    var z u64 = k +% GOLDEN
    z = (z ^ (z >> 30)) *% MIX1
    z = (z ^ (z >> 27)) *% MIX2
    z = z ^ (z >> 31)
    return u32(z >> 32)
}

fn raw(seed u64, x i32, y i32) i32 {
    var h u32 = hash32(seed, x, y)
    var r u32 = h % u32(16)
    return i32(32) + i32(r)
}

// Сосед со сдвигом на d; координата заворачивается в i32.
fn shift(c i32, d i64) i32 {
    return i32.wrap(i64(c) + d)
}

pub fn height(seed u64, x i32, y i32) i32 {
    var sum i32 = raw(seed, x, y)
    sum += raw(seed, shift(x, 1), y)
    sum += raw(seed, shift(x, -1), y)
    sum += raw(seed, x, shift(y, 1))
    sum += raw(seed, x, shift(y, -1))
    return sum / i32(5)
}
