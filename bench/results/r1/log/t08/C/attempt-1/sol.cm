// t08: заготовка — напишите тела функций по task.md.
pub struct Box {
    min_x i32
    min_y i32
    max_x i32
    max_y i32
}

pub struct Pair {
    i i32
    j i32
}

// Строгое пересечение по обеим осям; касание краёв — не пересечение.
fn overlaps(a Box, b Box) bool {
    return a.min_x < b.max_x && b.min_x < a.max_x && a.min_y < b.max_y && b.min_y < a.max_y
}

pub fn overlapping_pairs(boxes []Box) List[Pair] {
    var out List[Pair] = []
    n := len(boxes)
    i := 0
    while i < n {
        j := i + 1
        while j < n {
            if overlaps(boxes[i], boxes[j]) {
                out.push(Pair { i: i32(i), j: i32(j) })
            }
            j += 1
        }
        i += 1
    }
    return out
}
