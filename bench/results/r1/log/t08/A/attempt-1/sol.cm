// t08: заготовка — напишите тела функций по task.md.
pub struct Box {
    min_x: i32,
    min_y: i32,
    max_x: i32,
    max_y: i32,
}

pub struct Pair {
    i: i32,
    j: i32,
}

fn overlaps(a: &Box, b: &Box) -> bool {
    let ox = a.min_x < b.max_x && b.min_x < a.max_x;
    let oy = a.min_y < b.max_y && b.min_y < a.max_y;
    return ox && oy;
}

pub fn overlapping_pairs(boxes: []Box) -> List[Pair] {
    var out: List[Pair] = [];
    let n = len(boxes);
    for i in 0..n {
        let a = boxes[i];
        var j = i + 1;
        while j < n {
            let b = boxes[j];
            if overlaps(&a, &b) {
                out.push(Pair { i: i32(i), j: i32(j) });
            }
            j += 1;
        }
    }
    return out;
}
