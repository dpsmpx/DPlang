// t06: заготовка — напишите тела функций по task.md.
pub struct Quad {
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    block: i32,
}

pub fn greedy_mesh(w: i32, h: i32, cells: []i32) -> List[Quad] {
    var out: List[Quad] = [];
    let ww = int(w);
    let hh = int(h);
    if ww <= 0 || hh <= 0 {
        return out;
    }
    var seen: List[bool] = repeat(false, ww * hh);
    for y in 0..hh {
        for x in 0..ww {
            let b = cells[y * ww + x];
            if b == 0 || seen[y * ww + x] {
                continue;
            }
            var wd = 1;
            while x + wd < ww && cells[y * ww + x + wd] == b && !seen[y * ww + x + wd] {
                wd += 1;
            }
            var ht = 1;
            var grow = true;
            while grow && y + ht < hh {
                let row = y + ht;
                for k in 0..wd {
                    let idx = row * ww + x + k;
                    if cells[idx] != b || seen[idx] {
                        grow = false;
                    }
                }
                if grow {
                    ht += 1;
                }
            }
            for dy in 0..ht {
                for dx in 0..wd {
                    seen[(y + dy) * ww + x + dx] = true;
                }
            }
            out.push(Quad { x: i32(x), y: i32(y), w: i32(wd), h: i32(ht), block: b });
        }
    }
    return out;
}
