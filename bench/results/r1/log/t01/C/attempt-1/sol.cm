// t01: кольцевой буфер целых фиксированной ёмкости, порядок FIFO.
pub enum RingError {
    Full
}

pub struct Ring {
    buf List[i32]
    head int
    count int
}

pub fn ring_new(capacity i32) Ring {
    var buf List[i32] = repeat(i32(0), int(capacity))
    return Ring { buf, head: 0, count: 0 }
}

pub fn ring_push(r mut Ring, value i32) !void {
    cap := len(r.buf)
    if r.count >= cap {
        fail .Full
    }
    tail := (r.head + r.count) % cap
    r.buf[tail] = value
    r.count += 1
}

pub fn ring_pop(r mut Ring) ?i32 {
    if r.count == 0 {
        return none
    }
    v := r.buf[r.head]
    r.head = (r.head + 1) % len(r.buf)
    r.count -= 1
    return v
}

pub fn ring_len(r Ring) i32 {
    return i32(r.count)
}
