// t01: заготовка — напишите тела функций по task.md.
pub enum RingError {
    Full
}

pub struct Ring {
    // поля — на ваш выбор
    data: List[i32]
    head: int = 0
    count: int = 0
}

pub fn ring_new(capacity: i32) Ring {
    let data: List[i32] = repeat(i32(0), int(capacity))
    return Ring { data: data, head: 0, count: 0 }
}

pub fn ring_push(r: &mut Ring, value: i32) !void {
    let cap = len(r.data)
    if r.count >= cap {
        fail .Full
    }
    let tail = (r.head + r.count) % cap
    r.data[tail] = value
    r.count += 1
}

pub fn ring_pop(r: &mut Ring) ?i32 {
    if r.count == 0 {
        return none
    }
    let v = r.data[r.head]
    r.head = (r.head + 1) % len(r.data)
    r.count -= 1
    return v
}

pub fn ring_len(r: &Ring) i32 {
    return i32(r.count)
}
