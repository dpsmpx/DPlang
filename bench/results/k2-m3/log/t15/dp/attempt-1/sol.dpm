// t15: книга счетов с вложенными транзакциями.

const BOUND: i64 = 1000000000000000
const MAX_DEPTH: int = 8

pub struct Account {
    bal: i64
    limit: i64
}

pub struct Ledger {
    // открытые счета по имени
    accts: Map[str, Account]
    // снимки счетов на момент каждого незавершённого begin
    saved: List[Map[str, Account]]
}

pub fn ledger_new() Ledger {
    return Ledger { accts: [], saved: [] }
}

// Слова строки: разделитель — один или несколько пробелов.
fn words(line: str) List[str] {
    let parts = line.split(" ")
    var out: List[str] = []
    for p in &parts {
        if len(p) > 0 {
            out.push(p)
        }
    }
    return out
}

fn valid_name(s: str) bool {
    let n = len(s)
    if n < 1 || n > 16 {
        return false
    }
    for i in 0..n {
        let c = s[i]
        if c >= 'a' && c <= 'z' {
            continue
        }
        if i > 0 && (is_digit(c) || c == '_') {
            continue
        }
        return false
    }
    return true
}

// Число из 1..18 цифр; иначе -1.
fn parse_num(s: str) i64 {
    let n = len(s)
    if n < 1 || n > 18 {
        return -1
    }
    var v: i64 = 0
    for c in &s {
        if !is_digit(c) {
            return -1
        }
        v = v * 10 + i64(c - '0')
    }
    return v
}

fn do_open(l: &mut Ledger, name: str, num: str) str {
    if !valid_name(name) {
        return "error syntax"
    }
    let lim = parse_num(num)
    if lim < 0 {
        return "error syntax"
    }
    if l.accts.contains(name) {
        return "error exists " + name
    }
    l.accts[name] = Account { bal: 0, limit: lim }
    return "ok"
}

fn do_move(l: &mut Ledger, name: str, num: str, deposit: bool) str {
    if !valid_name(name) {
        return "error syntax"
    }
    let amt = parse_num(num)
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    var a = l.accts[name]
    var nb: i64 = 0
    if deposit {
        nb = a.bal + amt
    } else {
        nb = a.bal - amt
        if nb < -a.limit {
            return "error funds"
        }
    }
    if abs(nb) > BOUND {
        return "error bound"
    }
    a.bal = nb
    l.accts[name] = a
    return "ok " + str(nb)
}

fn do_transfer(l: &mut Ledger, fname: str, tname: str, num: str) str {
    if !valid_name(fname) || !valid_name(tname) {
        return "error syntax"
    }
    let amt = parse_num(num)
    if amt < 0 {
        return "error syntax"
    }
    if amt == 0 {
        return "error amount"
    }
    if !l.accts.contains(fname) {
        return "error unknown " + fname
    }
    if !l.accts.contains(tname) {
        return "error unknown " + tname
    }
    if fname == tname {
        return "error same"
    }
    var fee = amt / 100
    if fee < 1 {
        fee = 1
    }
    var fa = l.accts[fname]
    var ta = l.accts[tname]
    let nf = fa.bal - (amt + fee)
    let nt = ta.bal + amt
    if nf < -fa.limit {
        return "error funds"
    }
    if abs(nf) > BOUND {
        return "error bound"
    }
    if abs(nt) > BOUND {
        return "error bound"
    }
    fa.bal = nf
    ta.bal = nt
    l.accts[fname] = fa
    l.accts[tname] = ta
    return "ok " + str(nf) + " " + str(nt)
}

fn do_balance(l: &Ledger, name: str) str {
    if !valid_name(name) {
        return "error syntax"
    }
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    return str(l.accts[name].bal)
}

fn do_close(l: &mut Ledger, name: str) str {
    if !valid_name(name) {
        return "error syntax"
    }
    if !l.accts.contains(name) {
        return "error unknown " + name
    }
    if l.accts[name].bal != 0 {
        return "error nonzero"
    }
    _ = l.accts.remove(name)
    return "ok"
}

fn do_report(l: &Ledger) str {
    if len(l.accts) == 0 {
        return "(empty)"
    }
    var names: List[str] = []
    for k in &l.accts {
        names.push(k)
    }
    names.sort()
    var out = ""
    for i in 0..len(names) {
        if i > 0 {
            out += " "
        }
        out += names[i] + ":" + str(l.accts[names[i]].bal)
    }
    return out
}

pub fn ledger_exec(l: &mut Ledger, line: str) str {
    let w = words(line)
    let argc = len(w)
    if argc == 0 {
        return "error syntax"
    }
    let cmd = w[0]
    if cmd == "open" && argc == 3 {
        return do_open(&mut l, w[1], w[2])
    }
    if cmd == "deposit" && argc == 3 {
        return do_move(&mut l, w[1], w[2], true)
    }
    if cmd == "withdraw" && argc == 3 {
        return do_move(&mut l, w[1], w[2], false)
    }
    if cmd == "transfer" && argc == 4 {
        return do_transfer(&mut l, w[1], w[2], w[3])
    }
    if cmd == "balance" && argc == 2 {
        return do_balance(&l, w[1])
    }
    if cmd == "close" && argc == 2 {
        return do_close(&mut l, w[1])
    }
    if cmd == "report" && argc == 1 {
        return do_report(&l)
    }
    if cmd == "begin" && argc == 1 {
        if len(l.saved) >= MAX_DEPTH {
            return "error depth"
        }
        let snap = l.accts
        l.saved.push(snap)
        return "ok depth " + str(len(l.saved))
    }
    if cmd == "commit" && argc == 1 {
        if len(l.saved) == 0 {
            return "error depth"
        }
        _ = l.saved.pop()
        return "ok depth " + str(len(l.saved))
    }
    if cmd == "rollback" && argc == 1 {
        if len(l.saved) == 0 {
            return "error depth"
        }
        if let back = l.saved.pop() {
            l.accts = back
        }
        return "ok depth " + str(len(l.saved))
    }
    return "error syntax"
}
