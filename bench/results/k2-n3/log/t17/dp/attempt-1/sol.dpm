// t17: перенос и выравнивание текста.
pub enum Align {
    Left
    Right
    Center
    Justify
}

pub enum WrapError {
    BadWidth
}

fn words(s: str) List[str] {
    var out: List[str] = []
    for x in &s.split(" ") {
        if len(x) > 0 {
            out.push(x)
        }
    }
    return out
}

fn spaces(n: int) str {
    var s = ""
    for i in 0..n {
        s += " "
    }
    return s
}

fn join_words(ws: []str) str {
    var s = ""
    for i in 0..len(ws) {
        if i > 0 {
            s += " "
        }
        s += ws[i]
    }
    return s
}

fn fmt_line(ws: []str, w: int, align: Align, last: bool) str {
    let plain = join_words(ws)
    let n = len(plain)
    if align == Align.Left {
        return plain
    }
    if align == Align.Right {
        return spaces(w - n) + plain
    }
    if align == Align.Center {
        return spaces((w - n) / 2) + plain
    }
    // Justify
    if last || len(ws) < 2 {
        return plain
    }
    var total = 0
    for i in 0..len(ws) {
        total += len(ws[i])
    }
    let gaps = len(ws) - 1
    let sp = w - total
    let each = sp / gaps
    let extra = sp % gaps
    var s = ""
    for j in 0..len(ws) {
        if j > 0 {
            var k = each
            if j - 1 < extra {
                k += 1
            }
            s += spaces(k)
        }
        s += ws[j]
    }
    return s
}

// Строки абзаца: каждая — список слов.
fn fill(ws: []str, w: int) List[List[str]] {
    var lines: List[List[str]] = []
    var cur: List[str] = []
    var curlen = 0
    for i in 0..len(ws) {
        let word = ws[i]
        let wl = len(word)
        if wl > w {
            if len(cur) > 0 {
                lines.push(cur)
                cur = []
                curlen = 0
            }
            var rest = word
            while len(rest) > w {
                lines.push([rest[..w - 1] + "-"])
                rest = rest[w - 1..]
            }
            cur = [rest]
            curlen = len(rest)
        } else if len(cur) == 0 {
            cur = [word]
            curlen = wl
        } else if curlen + 1 + wl <= w {
            cur.push(word)
            curlen += 1 + wl
        } else {
            lines.push(cur)
            cur = [word]
            curlen = wl
        }
    }
    if len(cur) > 0 {
        lines.push(cur)
    }
    return lines
}

fn emit_para(out: &mut List[str], ws: []str, w: int, align: Align) {
    if len(out) > 0 {
        out.push("")
    }
    let lines = fill(ws, w)
    for i in 0..len(lines) {
        let last = i == len(lines) - 1
        out.push(fmt_line(lines[i], w, align, last))
    }
}

pub fn wrap(text: str, width: i32, align: Align) WrapError!List[str] {
    if width < 2 || width > 200 {
        fail .BadWidth
    }
    let w = int(width)
    var out: List[str] = []
    var para: List[str] = []
    for line in &text.split("\n") {
        let ws = words(line)
        if len(ws) == 0 {
            if len(para) > 0 {
                emit_para(&mut out, para, w, align)
                para = []
            }
        } else {
            for k in 0..len(ws) {
                para.push(ws[k])
            }
        }
    }
    if len(para) > 0 {
        emit_para(&mut out, para, w, align)
    }
    return out
}
