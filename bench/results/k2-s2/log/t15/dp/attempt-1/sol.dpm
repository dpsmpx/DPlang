// t15: книга счетов с вложенными транзакциями.

const BOUND: i64 = 1000000000000000
const MAX_DEPTH: int = 8

pub struct Account {
    name: str
    limit: i64
    bal: i64
}

pub struct Snapshot {
    accounts: List[Account]
}

pub struct Ledger {
    accounts: List[Account]
    snaps: List[Snapshot]
}

pub fn ledger_new() Ledger {
    return Ledger { accounts: [], snaps: [] }
}

// Слова строки: разделитель — только пробел.
fn split_words(line: str) List[str] {
    var out: List[str] = []
    let parts = line.split(" ")
    for p in &parts {
        if len(p) > 0 {
            out.push(p)
        }
    }
    return out
}

fn valid_name(s: str) bool {
    let n = len(s)
    if n < 1 || n > 16 {
        return false
    }
    for i in 0..n {
        let c = s[i]
        let lower = c >= 'a' && c <= 'z'
        if i == 0 {
            if !lower {
                return false
            }
        } else if !(lower || is_digit(c) || c == '_') {
            return false
        }
    }
    return true
}

// Число от 1 до 18 цифр; иначе -1.
fn parse_num(s: str) i64 {
    let n = len(s)
    if n < 1 || n > 18 {
        return -1
    }
    var v: i64 = 0
    for c in &s {
        if !is_digit(c) {
            return -1
        }
        v = v * 10 + i64(c - '0')
    }
    return v
}

fn find_acc(l: &Ledger, name: str) int {
    for i in 0..len(l.accounts) {
        if l.accounts[i].name == name {
            return i
        }
    }
    return -1
}

fn exceeds(b: i64) bool {
    return b > BOUND || b < -BOUND
}

pub fn ledger_exec(l: &mut Ledger, line: str) str {
    let w = split_words(line)
    if len(w) == 0 {
        return "error syntax"
    }
    let cmd = w[0]
    let argc = len(w) - 1
    if cmd == "open" {
        if argc != 2 || !valid_name(w[1]) {
            return "error syntax"
        }
        let lim = parse_num(w[2])
        if lim < 0 {
            return "error syntax"
        }
        if find_acc(&l, w[1]) >= 0 {
            return "error exists " + w[1]
        }
        let acc = Account { name: w[1], limit: lim, bal: 0 }
        l.accounts.push(acc)
        return "ok"
    }
    if cmd == "deposit" || cmd == "withdraw" {
        if argc != 2 || !valid_name(w[1]) {
            return "error syntax"
        }
        let amt = parse_num(w[2])
        if amt < 0 {
            return "error syntax"
        }
        if amt == 0 {
            return "error amount"
        }
        let i = find_acc(&l, w[1])
        if i < 0 {
            return "error unknown " + w[1]
        }
        let a = l.accounts[i]
        var nb: i64 = a.bal + amt
        if cmd == "withdraw" {
            nb = a.bal - amt
        }
        if nb < -a.limit {
            return "error funds"
        }
        if exceeds(nb) {
            return "error bound"
        }
        l.accounts[i].bal = nb
        return "ok " + str(nb)
    }
    if cmd == "transfer" {
        if argc != 3 || !valid_name(w[1]) || !valid_name(w[2]) {
            return "error syntax"
        }
        let amt = parse_num(w[3])
        if amt < 0 {
            return "error syntax"
        }
        if amt == 0 {
            return "error amount"
        }
        let fi = find_acc(&l, w[1])
        if fi < 0 {
            return "error unknown " + w[1]
        }
        let ti = find_acc(&l, w[2])
        if ti < 0 {
            return "error unknown " + w[2]
        }
        if fi == ti {
            return "error same"
        }
        var fee: i64 = amt / 100
        if fee < 1 {
            fee = 1
        }
        let fa = l.accounts[fi]
        let ta = l.accounts[ti]
        let nf = fa.bal - (amt + fee)
        let nt = ta.bal + amt
        if nf < -fa.limit {
            return "error funds"
        }
        if exceeds(nf) {
            return "error bound"
        }
        if exceeds(nt) {
            return "error bound"
        }
        l.accounts[fi].bal = nf
        l.accounts[ti].bal = nt
        return "ok " + str(nf) + " " + str(nt)
    }
    if cmd == "balance" {
        if argc != 1 || !valid_name(w[1]) {
            return "error syntax"
        }
        let i = find_acc(&l, w[1])
        if i < 0 {
            return "error unknown " + w[1]
        }
        return str(l.accounts[i].bal)
    }
    if cmd == "close" {
        if argc != 1 || !valid_name(w[1]) {
            return "error syntax"
        }
        let i = find_acc(&l, w[1])
        if i < 0 {
            return "error unknown " + w[1]
        }
        if l.accounts[i].bal != 0 {
            return "error nonzero"
        }
        _ = l.accounts.remove(i)
        return "ok"
    }
    if cmd == "begin" {
        if argc != 0 {
            return "error syntax"
        }
        if len(l.snaps) >= MAX_DEPTH {
            return "error depth"
        }
        let snap = Snapshot { accounts: l.accounts }
        l.snaps.push(snap)
        return "ok depth " + str(len(l.snaps))
    }
    if cmd == "commit" {
        if argc != 0 {
            return "error syntax"
        }
        if len(l.snaps) == 0 {
            return "error depth"
        }
        _ = l.snaps.pop()
        return "ok depth " + str(len(l.snaps))
    }
    if cmd == "rollback" {
        if argc != 0 {
            return "error syntax"
        }
        let n = len(l.snaps)
        if n == 0 {
            return "error depth"
        }
        l.accounts = l.snaps[n - 1].accounts
        _ = l.snaps.pop()
        return "ok depth " + str(len(l.snaps))
    }
    if cmd == "report" {
        if argc != 0 {
            return "error syntax"
        }
        if len(l.accounts) == 0 {
            return "(empty)"
        }
        var xs = l.accounts
        xs.sort()
        var out = ""
        for i in 0..len(xs) {
            if i > 0 {
                out = out + " "
            }
            out = out + xs[i].name + ":" + str(xs[i].bal)
        }
        return out
    }
    return "error syntax"
}
