#version 450
// Треугольник в кадре 64x64 (examples/triangle, Р64). Вершины — на углах
// пикселей: центр пикселя (k + 0.5) не лежит ни на одном ребре, и
// покрытие одинаково на любом драйвере.
const vec2 corners[3] = vec2[](vec2(32.0, 8.0), vec2(56.0, 56.0), vec2(8.0, 56.0));

void main() {
    // Пиксели кадра 64x64 → координаты Vulkan [-1, 1], y — вниз.
    gl_Position = vec4(corners[gl_VertexIndex] / 32.0 - 1.0, 0.0, 1.0);
}
